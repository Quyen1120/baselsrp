new ownerID, modelID, Float:fuel, carID, usernamee[32];

stock GetVehicleInfoFromDB(carID, playerid)
{
    new query[256];
    mysql_format(connectionID, query, sizeof(query), "SELECT * FROM vehicles WHERE id = %d", carID);
    mysql_tquery(connectionID, query, "OnVehicleInfoQuery", "ii", playerid, carID);

    return 1;
}

forward OnVehicleInfoQuery(playerid, carID);
public OnVehicleInfoQuery(playerid, carID)
{
    static rows, fields;
    cache_get_data(rows, fields, connectionID);

    if (rows > 0)
    {
        for (new i = 0; i < rows; i++)
        {
            ownerID = cache_get_field_content_int(i, "ownerid");
            fuel = cache_get_field_content_float(i, "fuel");
            modelID = cache_get_field_content_int(i, "model");

            GetUsernameFromDB(ownerID, playerid);
        }
    }
    else
    {
        SendMessage(playerid, COLOR_WHITE, "No vehicle found with that plate.");
    }

    return 1;
}

stock GetUsernameFromDB(uid, playerid)
{
    new query[256];
    mysql_format(connectionID, query, sizeof(query), "SELECT username FROM users WHERE uid = %d", uid);
    mysql_tquery(connectionID, query, "OnUsernameQuery", "ii", playerid, uid);
    return 1;
}

forward OnUsernameQuery(playerid, uid);
public OnUsernameQuery(playerid, uid)
{
    static rows, fields;
    cache_get_data(rows, fields, connectionID);

    if (rows > 0)
    {
        cache_get_field_content(0, "username", usernamee);
        SendProximityMessage(playerid, 10.0, COLOR_PURPLE, "** %s is turning off his mdc laptop", GetRPName(playerid));
    //    SendMessage(playerid, COLOR_WHITE, "The owner of the %s LSV-%d is "COL_RED"%s.", arrVehicleNames[modelID - 400], carID, usernamee);
		SendMessage(playerid, COLOR_WHITE, "The owner of the plate is "COL_RED"%s.", usernamee);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        RemovePlayerAttachedObject(playerid, 8);
        Menu_Hide(playerid);
    }
    else
    {
        SendMessage(playerid, COLOR_WHITE, "No name registered with that plate.");
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        RemovePlayerAttachedObject(playerid, 8);
        SendProximityMessage(playerid, 10.0, COLOR_PURPLE, "** %s is turning off his mdc laptop", GetRPName(playerid));
        Menu_Hide(playerid);
    }

    return 1;
}

new playerName[MAX_PLAYER_NAME];

stock GetUserInformation(playerName[], playerid)
{
    new query[256];
    mysql_format(connectionID, query, sizeof(query), "SELECT * FROM users WHERE username = '%s'", playerName);
    mysql_tquery(connectionID, query, "OnUserInfoQuery", "is", playerid, playerName);
    return 1;
}

forward OnUserInfoQuery(playerid, playerName[]);
public OnUserInfoQuery(playerid, playerName[])
{
    static rows, fields;
    cache_get_data(rows, fields, connectionID);

    if (rows > 0)
    {
        new skin, moneyBank, groupID, groupRank, loginDate[128];
        
        skin = cache_get_field_content_int(0, "skin");
        moneyBank = cache_get_field_content_int(0, "moneybank");
        groupID = cache_get_field_content_int(0, "group");
        groupRank = cache_get_field_content_int(0, "grouprank");
        cache_get_field_content(0, "regdate", loginDate);

       	new dialog[512];
		format(dialog, sizeof(dialog), "Information\tStatus\n");
		format(dialog, sizeof(dialog), "%sName:\t%s\n", dialog, playerName);
		format(dialog, sizeof(dialog), "%sClothes:\t%i\n", dialog, skin);
		format(dialog, sizeof(dialog), "%sBank:\t%i\n", dialog, moneyBank);
		format(dialog, sizeof(dialog), "%sGroup:\t%i\n", dialog, groupID);
		format(dialog, sizeof(dialog), "%sGroup Rank:\t%i\n", dialog, groupRank);
		format(dialog, sizeof(dialog), "%sCitizen Since:\t%s", dialog, loginDate);

		ShowPlayerDialog(playerid, 1, DIALOG_STYLE_TABLIST_HEADERS, "Citizen Lookup", dialog, "OK", "");

    }
    else
    {
        ShowPlayerDialog(playerid, 1, DIALOG_STYLE_MSGBOX, "Citizen Lookup", "No user found.", "OK", "");
    }
    return 1;
}


