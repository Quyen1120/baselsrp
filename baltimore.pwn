	GiveWeapon(playerid, 24, true);
	GiveWeapon(playerid, 27, true);
	GiveWeapon(playerid, 29, true);
	GiveWeapon(playerid, 31, true);
	GiveWeapon(playerid, 34, true);

	pData[playerid][pPaintball] = 1;
