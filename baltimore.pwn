			x = 385.000000;
			y += 43.0;
		}
		else
		{
			x += 30.0;
		}
		idx++;

        g_Inventory2PreviewModel[playerid][i] = CreatePlayerTextDraw(playerid, x, y, "Preview_Model");
        PlayerTextDrawFont(playerid, g_Inventory2PreviewModel[playerid][i], TEXT_DRAW_FONT_MODEL_PREVIEW);
        PlayerTextDrawLetterSize(playerid, g_Inventory2PreviewModel[playerid][i], 0.600000, 2.000000);
        PlayerTextDrawTextSize(playerid, g_Inventory2PreviewModel[playerid][i], 27.500000, 34.000000);
        PlayerTextDrawSetOutline(playerid, g_Inventory2PreviewModel[playerid][i], 0);
        PlayerTextDrawSetShadow(playerid, g_Inventory2PreviewModel[playerid][i], 0);
        PlayerTextDrawAlignment(playerid, g_Inventory2PreviewModel[playerid][i], 1);
        PlayerTextDrawColor(playerid, g_Inventory2PreviewModel[playerid][i], -1);
        PlayerTextDrawBackgroundColor(playerid, g_Inventory2PreviewModel[playerid][i], 30);
        PlayerTextDrawBoxColor(playerid, g_Inventory2PreviewModel[playerid][i], 255);
        PlayerTextDrawUseBox(playerid, g_Inventory2PreviewModel[playerid][i], false);
        PlayerTextDrawSetProportional(playerid, g_Inventory2PreviewModel[playerid][i], true);
        PlayerTextDrawSetSelectable(playerid, g_Inventory2PreviewModel[playerid][i], true);
        PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], 348);
        PlayerTextDrawSetPreviewRot(playerid, g_Inventory2PreviewModel[playerid][i], -10.000000, 0.000000, -22.000000, 1.369999);
        PlayerTextDrawSetPreviewVehCol(playerid, g_Inventory2PreviewModel[playerid][i], 1, 1);

        g_Inventory2GreenBox[playerid][i] = CreatePlayerTextDraw(playerid, x + 14.0, y + 28.0, "_");
		PlayerTextDrawFont(playerid, g_Inventory2GreenBox[playerid][i], 1);
		PlayerTextDrawLetterSize(playerid, g_Inventory2GreenBox[playerid][i], 0.600000, 0.500002);
		PlayerTextDrawTextSize(playerid, g_Inventory2GreenBox[playerid][i], 0.000000, 24.700000);
		PlayerTextDrawSetOutline(playerid, g_Inventory2GreenBox[playerid][i], 1);
		PlayerTextDrawSetShadow(playerid, g_Inventory2GreenBox[playerid][i], 0);
		PlayerTextDrawAlignment(playerid, g_Inventory2GreenBox[playerid][i], 2);
		PlayerTextDrawColor(playerid, g_Inventory2GreenBox[playerid][i], -1);
		PlayerTextDrawBackgroundColor(playerid, g_Inventory2GreenBox[playerid][i], 255);
		PlayerTextDrawBoxColor(playerid, g_Inventory2GreenBox[playerid][i], 4286578816);
		PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], true);
		PlayerTextDrawSetProportional(playerid, g_Inventory2GreenBox[playerid][i], true);
		PlayerTextDrawSetSelectable(playerid, g_Inventory2GreenBox[playerid][i], false);

        gInventory2ItemName[playerid][i] = CreatePlayerTextDraw(playerid, x + 14, y + 26.0, "Deagle");
        PlayerTextDrawFont(playerid, gInventory2ItemName[playerid][i], 1);
        PlayerTextDrawLetterSize(playerid, gInventory2ItemName[playerid][i], 0.087499, 0.600000);
        PlayerTextDrawTextSize(playerid, gInventory2ItemName[playerid][i], 385.000000, 25.000000);
        PlayerTextDrawSetOutline(playerid, gInventory2ItemName[playerid][i], 0);
        PlayerTextDrawSetShadow(playerid, gInventory2ItemName[playerid][i], 0);
        PlayerTextDrawAlignment(playerid, gInventory2ItemName[playerid][i], 2);
        PlayerTextDrawColor(playerid, gInventory2ItemName[playerid][i], -1);
        PlayerTextDrawBackgroundColor(playerid, gInventory2ItemName[playerid][i], 255);
        PlayerTextDrawBoxColor(playerid, gInventory2ItemName[playerid][i], 9109759);
        PlayerTextDrawUseBox(playerid, gInventory2ItemName[playerid][i], false);
        PlayerTextDrawSetProportional(playerid, gInventory2ItemName[playerid][i], true);
        PlayerTextDrawSetSelectable(playerid, gInventory2ItemName[playerid][i], false);

        gInventory2Quantity[playerid][i] = CreatePlayerTextDraw(playerid, x + 1, y + 1, "5");
		PlayerTextDrawFont(playerid, gInventory2Quantity[playerid][i], 1);
		PlayerTextDrawLetterSize(playerid, gInventory2Quantity[playerid][i], 0.124999, 0.650000);
		PlayerTextDrawTextSize(playerid, gInventory2Quantity[playerid][i], 163.000000, 25.000000);
		PlayerTextDrawSetOutline(playerid, gInventory2Quantity[playerid][i], 0);
		PlayerTextDrawSetShadow(playerid, gInventory2Quantity[playerid][i], 0);
		PlayerTextDrawAlignment(playerid, gInventory2Quantity[playerid][i], 1);
		PlayerTextDrawColor(playerid, gInventory2Quantity[playerid][i], -1);
		PlayerTextDrawBackgroundColor(playerid, gInventory2Quantity[playerid][i], 255);
		PlayerTextDrawBoxColor(playerid, gInventory2Quantity[playerid][i], 9109759);
		PlayerTextDrawUseBox(playerid, gInventory2Quantity[playerid][i], false);
		PlayerTextDrawSetProportional(playerid, gInventory2Quantity[playerid][i], true);
		PlayerTextDrawSetSelectable(playerid, gInventory2Quantity[playerid][i], false);
    }

	new string[128], count = 0, id = Item_Nearest(playerid), targetid = GetNearbyPlayerID(playerid, 2.0), houseid = GetNearbyHouseStash(playerid, 2.0), bizid = GetInsideBusiness(playerid);

	if(id != -1)
	{
		PickupMode[playerid] = 1;

		for (new i = 0; i < MAX_DROPPED_ITEMS; i++)
		{
			if (DroppedItems[i][droppedModel] && IsPlayerInRangeOfPoint(playerid, 1.5, DroppedItems[i][droppedPos][0], DroppedItems[i][droppedPos][1], DroppedItems[i][droppedPos][2]) && GetPlayerInterior(playerid) == DroppedItems[i][droppedInt] && GetPlayerVirtualWorld(playerid) == DroppedItems[i][droppedWorld]) 
			{
				NearestItems[playerid][count++] = i;
				
				if (count <= MAX_INVENTORY)
				{
					PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][count-1], DroppedItems[i][droppedModel]);

					format(string, sizeof(string), "%s", DroppedItems[i][droppedItem]);
					PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][count-1], string);

				//	PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][count-1], "%s", DroppedItems[i][droppedItem]);

					format(string, sizeof(string), "%i", DroppedItems[i][droppedQuantity]);
					PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][count-1], string);

					PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][count-1], true);
				}
			}
		}

		// hide remaining text draws
		for (new i = count; i < MAX_INVENTORY; i++)
		{
			PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], 19300); // set preview model to 0 to hide it
			PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], " ");
			PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], " ");
			PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], false);
		}

		for (new i = 0; i < MAX_INVENTORY; i ++) {
			PlayerTextDrawShow(playerid, g_Inventory2PreviewModel[playerid][i]);
			PlayerTextDrawShow(playerid, g_Inventory2GreenBox[playerid][i]);
			PlayerTextDrawShow(playerid, gInventory2ItemName[playerid][i]);
			PlayerTextDrawShow(playerid, gInventory2Quantity[playerid][i]);
		}
		PlayerTextDrawShow(playerid, g_Inventory2Background[playerid]);
		PlayerTextDrawShow(playerid, gInventory2PName[playerid]);
		return 1;
	}
	if(targetid != -1 || Friskmode != INVALID_PLAYER_ID) {
		if(Friskmode != INVALID_PLAYER_ID) {
			LootMode[playerid] = Friskmode;
			targetid = Friskmode;
		} else if(Friskmode == INVALID_PLAYER_ID) {
			LootMode[playerid] = targetid;
		}
		
		new stringg[128];
		format(stringg, sizeof(stringg), "%s's Items", GetRPName(targetid));
		PlayerTextDrawSetString(playerid, gInventory2PName[playerid], stringg);

		for (new i = 0; i < MAX_INVENTORY; i ++) {
			if(!InventoryData[targetid][i][invExists]) {
				PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], 19300);

				new stringgg[128];
				format(stringgg, sizeof(stringgg), " ");
				PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], stringgg);

				format(stringgg, sizeof(stringgg), " ");
				PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], stringgg);


			//	PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], " ");
		//		PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], " ");
				PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], false);
			} else {
				PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], InventoryData[targetid][i][invModel]);

				new stringgg[128];
				format(stringgg, sizeof(stringgg), "%s", InventoryData[targetid][i][invItem]);
				PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], stringgg);

				format(string, sizeof(string), "%i", InventoryData[targetid][i][invQuantity]);
				PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], string);

			//	PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], "%s", InventoryData[targetid][i][invItem]);
		//		format(string, sizeof(string), "%i", InventoryData[targetid][i][invQuantity]);
			//	PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], string);
				PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], true);
			}
			PlayerTextDrawShow(playerid, g_Inventory2PreviewModel[playerid][i]);
			PlayerTextDrawShow(playerid, g_Inventory2GreenBox[playerid][i]);
			PlayerTextDrawShow(playerid, gInventory2ItemName[playerid][i]);
			PlayerTextDrawShow(playerid, gInventory2Quantity[playerid][i]);
		}
		PlayerTextDrawShow(playerid, g_Inventory2Background[playerid]);
		PlayerTextDrawShow(playerid, gInventory2PName[playerid]);
		return 1;
	}
	if(bizid != -1)
	{
		ShowStoreItems(playerid, bizid);
		return 1;
	}
	/*if(vehicleid != -1)
	{
	//	VehShowStashItems(playerid, vehicleid);
		return 1;
	}*/
	if(houseid != -1)
	{
		ShowStashItems(playerid, houseid);
		return 1;
	}
	else {
		for (new i = 0; i < MAX_INVENTORY; i++)
		{
			PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], 19300); // set preview model to 0 to hide it
			PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], " ");
			PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], " ");
			PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], false);

			PlayerTextDrawShow(playerid, g_Inventory2PreviewModel[playerid][i]);
			PlayerTextDrawShow(playerid, g_Inventory2GreenBox[playerid][i]);
			PlayerTextDrawShow(playerid, gInventory2ItemName[playerid][i]);
			PlayerTextDrawShow(playerid, gInventory2Quantity[playerid][i]);
		}
		PlayerTextDrawShow(playerid, g_Inventory2Background[playerid]);
		PlayerTextDrawShow(playerid, gInventory2PName[playerid]);
		return 1;
	}
}

enum E_HOUSE_STASH 
{
	invExists,
	invID,
	invItem[128],
	invModel,
	invQuantity
};
new HouseInventoryData[MAX_PLAYERS][MAX_INVENTORY][E_HOUSE_STASH];

CountStashItems(playerid)
{
    new count;

    for (new i = 0; i != MAX_INVENTORY; i ++) if (HouseInventoryData[playerid][i][invExists]) {
        count++;
	}
	return count;
}

StashGetFreeID(houseid)
{
	if (CountStashItems(houseid) >= 20)
		return -1;

	for (new i = 0; i < MAX_INVENTORY; i ++)
	{
	    if (!HouseInventoryData[houseid][i][invExists])
	        return i;
	}
	return -1;
}

StashAddItems(playerid, houseid, const item[], model, quantity = 1)
{
	new string[128], itemid = StashGetFreeID(houseid);

    if (itemid != -1)
    {
        HouseInventoryData[houseid][itemid][invExists] = true;
        HouseInventoryData[houseid][itemid][invModel] = model;
        HouseInventoryData[houseid][itemid][invQuantity] = quantity;

        strcpy(HouseInventoryData[houseid][itemid][invItem], item, 128);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO `houses_inventory` (ownerID, invItem, invModel, invQuantity, slot) VALUES(%d, '%e', %d, %d, %d)", HouseInfo[houseid][hID], HouseInventoryData[houseid][itemid][invItem], model, quantity, itemid);
        mysql_tquery(connectionID, queryBuffer, "OnStashInventoryAdd", "dd", houseid, itemid);

		if(ShowingStashItems[playerid] != -1) {
			PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][itemid], HouseInventoryData[houseid][itemid][invModel]);
			PlayerTextDrawBackgroundColor(playerid, g_Inventory2PreviewModel[playerid][itemid], 30);
			PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][itemid], HouseInventoryData[houseid][itemid][invItem]);
			format(string, sizeof(string), "%i", HouseInventoryData[houseid][itemid][invQuantity]);
			PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][itemid], string);
			PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][itemid], true);
			PlayerTextDrawShow(playerid, gInventory2ItemName[playerid][itemid]);
			PlayerTextDrawShow(playerid, g_Inventory2PreviewModel[playerid][itemid]);
			PlayerTextDrawShow(playerid, g_Inventory2GreenBox[playerid][itemid]);
		}
		return 1;
    }
	else if(itemid == -1)
	{
		return SendMessage(playerid, COLOR_GREEN, "Your Inventory is full");
	}
	return 1;
}

forward OnStashInventoryAdd(houseid, itemid);
public OnStashInventoryAdd(houseid, itemid)
{
	HouseInventoryData[houseid][itemid][invID] = cache_insert_id();
	return 1;
}

ShowStashItems(playerid, houseid)
{
    if(HouseInfo[houseid][hStashLocked] != 0) return SCM(playerid, COLOR_PLUM, "This stash is locked.");

    new string[128];
    ShowingStashItems[playerid] = houseid;

	format(string, sizeof(string), "%s's Stash", HouseInfo[houseid][hOwner]);
	PlayerTextDrawSetString(playerid, gInventory2PName[playerid], string);
    for (new i = 0; i < MAX_INVENTORY; i ++) {
        if(!HouseInventoryData[houseid][i][invExists]) {
            PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], 19300);
            PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], " ");
            PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], " ");
            PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], false);
        } else {
            PlayerTextDrawSetPreviewModel(playerid, g_Inventory2PreviewModel[playerid][i], HouseInventoryData[houseid][i][invModel]);
			format(string, sizeof(string), "%s", HouseInventoryData[houseid][i][invItem]);
            PlayerTextDrawSetString(playerid, gInventory2ItemName[playerid][i], string);
            format(string, sizeof(string), "%i", HouseInventoryData[houseid][i][invQuantity]);
            PlayerTextDrawSetString(playerid, gInventory2Quantity[playerid][i], string);
            PlayerTextDrawUseBox(playerid, g_Inventory2GreenBox[playerid][i], true);
        }
        PlayerTextDrawShow(playerid, g_Inventory2PreviewModel[playerid][i]);
        PlayerTextDrawShow(playerid, g_Inventory2GreenBox[playerid][i]);
        PlayerTextDrawShow(playerid, gInventory2ItemName[playerid][i]);
        PlayerTextDrawShow(playerid, gInventory2Quantity[playerid][i]);
    }
    PlayerTextDrawShow(playerid, g_Inventory2Background[playerid]);
    PlayerTextDrawShow(playerid, gInventory2PName[playerid]);
    return 1;
}

StashRemoveItems(houseid, itemid, quantity)
{
	new string[128];
	if (HouseInventoryData[houseid][itemid][invQuantity] > 0)
	{
		HouseInventoryData[houseid][itemid][invQuantity] -= quantity;
	}
	if (quantity == -1 || HouseInventoryData[houseid][itemid][invQuantity] < 1)
	{
		HouseInventoryData[houseid][itemid][invExists] = false;
		HouseInventoryData[houseid][itemid][invModel] = 0;
		HouseInventoryData[houseid][itemid][invQuantity] = 0;

		format(string, sizeof(string), "DELETE FROM `houses_inventory` WHERE `ownerID` = '%d' AND `invID` = '%d'", HouseInfo[houseid][hID], HouseInventoryData[houseid][itemid][invID]);
		mysql_tquery(connectionID, string);
	}
	else if (quantity != -1 && HouseInventoryData[houseid][itemid][invQuantity] > 0)
	{
		format(string, sizeof(string), "UPDATE `houses_inventory` SET `invQuantity` = `invQuantity` - %d WHERE `ownerID` = '%d' AND `invID` = '%d'", quantity, HouseInfo[houseid][hID], HouseInventoryData[houseid][itemid][invID]);
		mysql_tquery(connectionID, string);
	}
	return 1;
}

ShowInventoryItems(playerid)
{
	new string[128];

	ShowingInventory[playerid] = 1;
	SelectTextDraw(playerid, 0x8234FFFF);

	PlayerTextDrawShow(playerid, g_InventoryBackground[playerid][0]);
	PlayerTextDrawShow(playerid, g_InventoryBackground[playerid][1]);

	for (new i = 0; i < MAX_INVENTORY; i ++) {
		if(!InventoryData[playerid][i][invExists]) {
			PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][i], 19300);
			PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][i], " ");
			PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][i], " ");
			PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][i], false);
		} else {
			PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][i], InventoryData[playerid][i][invModel]);
			new stringgg[128];
			format(stringgg, sizeof(stringgg), "%s", InventoryData[playerid][i][invItem]);
			PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][i], stringgg);
			format(string, sizeof(string), "%i", InventoryData[playerid][i][invQuantity]);
			PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][i], string);
			PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][i], true);
		}
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][i]);
        PlayerTextDrawShow(playerid, g_InventoryGreenBox[playerid][i]);
        PlayerTextDrawShow(playerid, gInventoryItemName[playerid][i]);
		PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][i]);
	}

	PlayerTextDrawShow(playerid, gInventoryPName[playerid][0]);
	PlayerTextDrawShow(playerid, gInventoryWeightInfo[playerid][0]);
	PlayerTextDrawShow(playerid, gInventoryInteraction[playerid][0]);
	PlayerTextDrawShow(playerid, gInventoryInteraction[playerid][1]);
	PlayerTextDrawShow(playerid, gInventoryInteraction[playerid][2]);
	PlayerTextDrawShow(playerid, gInventoryInteraction[playerid][3]);

	if(pData[playerid][pHoldWeapon]) PlayerTextDrawShow(playerid, gInventoryInteraction[playerid][4]);

	new stringg[128];
	format(stringg, sizeof(stringg), "%s's Inventory", GetRPName(playerid));
	PlayerTextDrawSetString(playerid, gInventoryPName[playerid][0], stringg);

//	new stringgg[128];
	format(stringg, sizeof(stringg), "%i.0 / 20.0 lbs", Inventory_Items(playerid));
	PlayerTextDrawSetString(playerid, gInventoryWeightInfo[playerid][0], stringg);

}

HidePlayerInventory(playerid)
{
	selectedItem[playerid] = -1;
	ShowingInventory[playerid] = 0;

	if(LootMode[playerid] != -1) LootMode[playerid] = -1;
	if(PickupMode[playerid]) PickupMode[playerid] = 0;
	if(PlayerIsInStore[playerid] != -1) PlayerIsInStore[playerid] = -1;
	if(ShowingStashItems[playerid] != -1) ShowingStashItems[playerid] = -1;

	for (new i = 0; i < MAX_INVENTORY; i ++) {
		PlayerTextDrawDestroy(playerid, g_InventoryPreviewModel[playerid][i]);
        PlayerTextDrawDestroy(playerid, g_InventoryGreenBox[playerid][i]);
        PlayerTextDrawDestroy(playerid, gInventoryItemName[playerid][i]);
		PlayerTextDrawDestroy(playerid, gInventoryQuantity[playerid][i]);

		PlayerTextDrawDestroy(playerid, g_Inventory2PreviewModel[playerid][i]);
        PlayerTextDrawDestroy(playerid, g_Inventory2GreenBox[playerid][i]);
        PlayerTextDrawDestroy(playerid, gInventory2ItemName[playerid][i]);
		PlayerTextDrawDestroy(playerid, gInventory2Quantity[playerid][i]);
	}

	PlayerTextDrawDestroy(playerid, g_Inventory2Background[playerid]);
	PlayerTextDrawDestroy(playerid, gInventory2PName[playerid]);

	PlayerTextDrawDestroy(playerid, g_InventoryBackground[playerid][0]);
	PlayerTextDrawDestroy(playerid, g_InventoryBackground[playerid][1]);
	PlayerTextDrawDestroy(playerid, gInventoryPName[playerid][0]);
	PlayerTextDrawDestroy(playerid, gInventoryWeightInfo[playerid][0]);
	PlayerTextDrawDestroy(playerid, gInventoryInteraction[playerid][0]);
	PlayerTextDrawDestroy(playerid, gInventoryInteraction[playerid][1]);
	PlayerTextDrawDestroy(playerid, gInventoryInteraction[playerid][2]);
	PlayerTextDrawDestroy(playerid, gInventoryInteraction[playerid][3]);
	PlayerTextDrawDestroy(playerid, gInventoryInteraction[playerid][4]);

    CancelSelectTextDraw(playerid);
}

ShowAddItemNotification(playerid, const item[], model)
{
	if(ShowingItemNotification[playerid])
	{
		PlayerTextDrawSetPreviewModel(playerid, ItemNotifcationPTD[playerid][0], model);
		//PlayerTextDrawSetString(playerid, ItemNotifcationPTD[playerid][2], "%s", item);
		new stringggg[128];
		format(stringggg, sizeof(stringggg), "%s", item);
		PlayerTextDrawSetString(playerid, ItemNotifcationPTD[playerid][2], stringggg);
		return 1;
	}

	ShowingItemNotification[playerid] = 1;

	ItemNotifcationPTD[playerid][0] = CreatePlayerTextDraw(playerid, 297.000000, 270.000000, "Preview_Model");
	PlayerTextDrawFont(playerid, ItemNotifcationPTD[playerid][0], TEXT_DRAW_FONT_MODEL_PREVIEW);
	PlayerTextDrawLetterSize(playerid, ItemNotifcationPTD[playerid][0], 0.600000, 2.000000);
	PlayerTextDrawTextSize(playerid, ItemNotifcationPTD[playerid][0], 32.000000, 35.000000);
	PlayerTextDrawSetOutline(playerid, ItemNotifcationPTD[playerid][0], 0);
	PlayerTextDrawSetShadow(playerid, ItemNotifcationPTD[playerid][0], 0);
	PlayerTextDrawAlignment(playerid, ItemNotifcationPTD[playerid][0], 1);
	PlayerTextDrawColor(playerid, ItemNotifcationPTD[playerid][0], -1);
	PlayerTextDrawBackgroundColor(playerid, ItemNotifcationPTD[playerid][0], 54);
	PlayerTextDrawBoxColor(playerid, ItemNotifcationPTD[playerid][0], 255);
	PlayerTextDrawUseBox(playerid, ItemNotifcationPTD[playerid][0], false);
	PlayerTextDrawSetProportional(playerid, ItemNotifcationPTD[playerid][0], true);
	PlayerTextDrawSetSelectable(playerid, ItemNotifcationPTD[playerid][0], false);
	PlayerTextDrawSetPreviewModel(playerid, ItemNotifcationPTD[playerid][0], 0);
	PlayerTextDrawSetPreviewRot(playerid, ItemNotifcationPTD[playerid][0], -10.000000, 0.000000, -20.000000, 1.000000);
	PlayerTextDrawSetPreviewVehCol(playerid, ItemNotifcationPTD[playerid][0], 1, 1);

	ItemNotifcationPTD[playerid][1] = CreatePlayerTextDraw(playerid, 298.000000, 271.000000, "Received");
	PlayerTextDrawFont(playerid, ItemNotifcationPTD[playerid][1], 1);
	PlayerTextDrawLetterSize(playerid, ItemNotifcationPTD[playerid][1], 0.125000, 0.650000);
	PlayerTextDrawTextSize(playerid, ItemNotifcationPTD[playerid][1], 327.000000, 17.000000);
	PlayerTextDrawSetOutline(playerid, ItemNotifcationPTD[playerid][1], 0);
	PlayerTextDrawSetShadow(playerid, ItemNotifcationPTD[playerid][1], 0);
	PlayerTextDrawAlignment(playerid, ItemNotifcationPTD[playerid][1], 1);
	PlayerTextDrawColor(playerid, ItemNotifcationPTD[playerid][1], -1);
	PlayerTextDrawBackgroundColor(playerid, ItemNotifcationPTD[playerid][1], 255);
	PlayerTextDrawBoxColor(playerid, ItemNotifcationPTD[playerid][1], 50);
	PlayerTextDrawUseBox(playerid, ItemNotifcationPTD[playerid][1], false);
	PlayerTextDrawSetProportional(playerid, ItemNotifcationPTD[playerid][1], true);
	PlayerTextDrawSetSelectable(playerid, ItemNotifcationPTD[playerid][1], false);

	ItemNotifcationPTD[playerid][2] = CreatePlayerTextDraw(playerid, 313.000000, 297.000000, "M4A1");
	PlayerTextDrawFont(playerid, ItemNotifcationPTD[playerid][2], 1);
	PlayerTextDrawLetterSize(playerid, ItemNotifcationPTD[playerid][2], 0.125000, 0.650000);
	PlayerTextDrawTextSize(playerid, ItemNotifcationPTD[playerid][2], 328.500000, 29.500000);
	PlayerTextDrawSetOutline(playerid, ItemNotifcationPTD[playerid][2], 0);
	PlayerTextDrawSetShadow(playerid, ItemNotifcationPTD[playerid][2], 0);
	PlayerTextDrawAlignment(playerid, ItemNotifcationPTD[playerid][2], 2);
	PlayerTextDrawColor(playerid, ItemNotifcationPTD[playerid][2], -1);
	PlayerTextDrawBackgroundColor(playerid, ItemNotifcationPTD[playerid][2], 255);
	PlayerTextDrawBoxColor(playerid, ItemNotifcationPTD[playerid][2], 50);
	PlayerTextDrawUseBox(playerid, ItemNotifcationPTD[playerid][2], true);
	PlayerTextDrawSetProportional(playerid, ItemNotifcationPTD[playerid][2], true);
	PlayerTextDrawSetSelectable(playerid, ItemNotifcationPTD[playerid][2], false);


	PlayerTextDrawSetPreviewModel(playerid, ItemNotifcationPTD[playerid][0], model);

	new stringggg[128];
	format(stringggg, sizeof(stringggg), "%s", item);
	PlayerTextDrawSetString(playerid, ItemNotifcationPTD[playerid][2], stringggg);

	PlayerTextDrawShow(playerid, ItemNotifcationPTD[playerid][0]);
	PlayerTextDrawShow(playerid, ItemNotifcationPTD[playerid][1]);
	PlayerTextDrawShow(playerid, ItemNotifcationPTD[playerid][2]);

	SetTimerEx("RemoveItemNotification", 2700, false, "i", playerid);
	return 1;
}
