public SprayMoneyLoop(playerid)
{
    if(!IsSprayingMoney[playerid])
        return 1;

    ApplyAnimation(playerid, "STRIP", "PLY_CASH", 4.1, 0, 0, 0, 0, 0, 1);

    RemovePlayerAttachedObject(playerid, 5);

    SetPlayerAttachedObject(playerid,
    5,
    1212,
    5,
    0.120000,
    0.020000,
    0.000000,
    0.000000,
    90.000000,
    0.000000,
    1.000000,
    1.000000,
    1.000000);

    SetTimerEx("RemoveSprayMoney", 700, false, "i", playerid);
    
    AddPlayerClass
    (
        0,
        1958.3783,
        1343.1572,
        15.3746,
        269.1425,
        0,
        0,
        0,
        0,
        0,
        0
    );
    
            CreateDynamicPickup
    (
        1279,
        1,
        2795.0,
        -1619.0,
        10.9,
        -1,
        -1,
        -1,
        50.0
    );
    
//Global Textdraws:
		LoginScreen[0] = TextDrawCreate(110.000000, 5.226665, "loadsc8:loadsc8");
		TextDrawLetterSize(LoginScreen[0], 0.000000, 0.000000);
		TextDrawTextSize(LoginScreen[0], 532.500000, 357.653778);
		TextDrawAlignment(LoginScreen[0], 1);
		TextDrawColor(LoginScreen[0], -1);
		TextDrawSetShadow(LoginScreen[0], 0);
		TextDrawSetOutline(LoginScreen[0], 0);
		TextDrawFont(LoginScreen[0], 4);
		LoginScreen[1] = TextDrawCreate(0.000000, 0.000000, "LD_SPAC:white");
		TextDrawLetterSize(LoginScreen[1], 0.000000, 0.000000);
		TextDrawTextSize(LoginScreen[1], 301.250000, 448.000000);
		TextDrawAlignment(LoginScreen[1], 1);
		TextDrawColor(LoginScreen[1], 255);
		TextDrawSetShadow(LoginScreen[1], 0);
