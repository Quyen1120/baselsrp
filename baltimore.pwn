            selectedItem[playerid] = -1;
        } else {
            new string[128];
            format(string, sizeof(string), "%i", InventoryData[playerid][selectedItem[playerid]][invQuantity]);
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], string);
            PlayerTextDrawHide(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
        }
	}
	if(CompareStrings("Boombox", item)) {

	    HidePlayerInventory(playerid);

        SCM(playerid, COLOR_SYNTAX, "Use /boombox.");

        if(InventoryData[playerid][selectedItem[playerid]][invQuantity] <= 0) {
            PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 19300);
            PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 30);
            PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][selectedItem[playerid]], " ");
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], " ");
            PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]], false);
            PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]]);
            PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
            selectedItem[playerid] = -1;
        } else {
            new string[128];
            format(string, sizeof(string), "%i", InventoryData[playerid][selectedItem[playerid]][invQuantity]);
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], string);
            PlayerTextDrawHide(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
        }
	}
	if(CompareStrings("Harness", item)) {

	    HidePlayerInventory(playerid);

        if(IsPlayerInAnyVehicle(playerid) == 0)
		{
			SCM(playerid, COLOR_WHITE, "You are not in a vehicle!");
			return 1;
		}
		if(IsPlayerInAnyVehicle(playerid) == 1 && ExBJck[playerid] == 0)
		{
			ExBJck[playerid] = 1;
			SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "* %s reaches for their harness, and buckles it up.", GetRPName(playerid));
			SCM(playerid, COLOR_WHITE, "You have put on your harness.");
		}

		Inventory_RemoveEx(playerid, itemid, 1);

        if(InventoryData[playerid][selectedItem[playerid]][invQuantity] <= 0) {
            PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 19300);
            PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 30);
            PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][selectedItem[playerid]], " ");
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], " ");
            PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]], false);
            PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]]);
            PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
            selectedItem[playerid] = -1;
        } else {
            new string[128];
            format(string, sizeof(string), "%i", InventoryData[playerid][selectedItem[playerid]][invQuantity]);
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], string);
            PlayerTextDrawHide(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
        }
	}
    if(CompareStrings("Cigarette", item)) {
        if(!Inventory_HasItem(playerid, "Lighter"))		return SendMessage(playerid, COLOR_REALRED, "You don't have a lighter in your inventory.");
        //if(!Inventory_Count(playerid, CIGAC) > 0 && !Inventory_Count(playerid, LIGHTERC) > 0) return 0;
		SendProximityMessage(playerid, 10.0, SERVER_COLOR, "** %s lights up a cigarette and start smoking.", GetRPName(playerid));
	    HidePlayerInventory(playerid);

        switch(random(4))
        {
            case 0:
            {
                ApplyAnimationEx(playerid, "GANGS", "smkcig_prtl", 4.0999, false, true, true, true, 0);
            }
            case 1:
            {
                ApplyAnimationEx(playerid, "SMOKING", "F_smklean_loop", 4.0999, true, true, true, true, 0);
            }
            case 2:
            {
                ApplyAnimationEx(playerid, "SMOKING", "M_smk_drag", 4.0999, false, true, true, true, 0);
            }
            case 3:
            {
                ApplyAnimationEx(playerid, "SMOKING", "M_smk_in", 4.0999, false, true, true, true, 0);
            }
        }
        
        SetPlayerAttachedObject(playerid, 9, 19625, 6, 0.100998, 0.014999, 0.020999, 0.109000, 0.018000, 0.031000, 1.000000, 1.000000, 1.000000, 0xFFFFFFFF, 0xFFFFFFFF);
       // SetPlayerAttachedObject(playerid, 9, 19625, 6, 0.0000, 0.0000, 0.0000, 0.100999, 0.015000, 0.021000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF);

		SetTimerEx("Cigarette1", 20000, false, "i", playerid);
        Inventory_RemoveEx(playerid, itemid, 1);

        if(InventoryData[playerid][selectedItem[playerid]][invQuantity] <= 0) {
            PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 19300);
            PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 30);
            PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][selectedItem[playerid]], " ");
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], " ");
            PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]], false);
            PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]]);
            PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
            selectedItem[playerid] = -1;
        } else {
            new string[128];
            format(string, sizeof(string), "%i", InventoryData[playerid][selectedItem[playerid]][invQuantity]);
            PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], string);
            PlayerTextDrawHide(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
            PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
        }
	}

	//LoadHolsters(playerid);
    SendProximityMessage(playerid, 10.0, SERVER_COLOR, "**{C2A2DA} %s takes out their %s.", GetRPName(playerid), item);

	new string[128];
	format(string, sizeof(string),"%s takes out their %s.", GetRPName(playerid), item);
	//DCC_SendChannelMessage(Useitem_Channel,string);
	return 1;
}
