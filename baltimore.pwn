        PlayerTextDrawSetProportional(playerid, gInventoryItemName[playerid][i], true);
        PlayerTextDrawSetSelectable(playerid, gInventoryItemName[playerid][i], false);

		gInventoryQuantity[playerid][i] = CreatePlayerTextDraw(playerid, x + 1, y + 1, "5");
		PlayerTextDrawFont(playerid, gInventoryQuantity[playerid][i], 1);
		PlayerTextDrawLetterSize(playerid, gInventoryQuantity[playerid][i], 0.124999, 0.650000);
		PlayerTextDrawTextSize(playerid, gInventoryQuantity[playerid][i], 163.000000, 25.000000);
		PlayerTextDrawSetOutline(playerid, gInventoryQuantity[playerid][i], 0);
		PlayerTextDrawSetShadow(playerid, gInventoryQuantity[playerid][i], 0);
		PlayerTextDrawAlignment(playerid, gInventoryQuantity[playerid][i], 1);
		PlayerTextDrawColor(playerid, gInventoryQuantity[playerid][i], -1);
		PlayerTextDrawBackgroundColor(playerid, gInventoryQuantity[playerid][i], 255);
		PlayerTextDrawBoxColor(playerid, gInventoryQuantity[playerid][i], 9109759);
		PlayerTextDrawUseBox(playerid, gInventoryQuantity[playerid][i], false);
		PlayerTextDrawSetProportional(playerid, gInventoryQuantity[playerid][i], true);
		PlayerTextDrawSetSelectable(playerid, gInventoryQuantity[playerid][i], false);
    }
	if(targetid != INVALID_PLAYER_ID) {
		Create2Inventory(playerid, targetid);
	} else if(targetid == INVALID_PLAYER_ID) {
		Create2Inventory(playerid);
	}
	

	ShowInventoryItems(playerid);
}

