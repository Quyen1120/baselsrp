        gInventoryItemName[playerid][i] = CreatePlayerTextDraw(playerid, x + 14, y + 26.0, "Deagle");
        PlayerTextDrawFont(playerid, gInventoryItemName[playerid][i], 1);
        PlayerTextDrawLetterSize(playerid, gInventoryItemName[playerid][i], 0.087499, 0.600000);
        PlayerTextDrawTextSize(playerid, gInventoryItemName[playerid][i], 385.000000, 25.000000);
