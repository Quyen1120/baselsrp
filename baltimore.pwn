	if (dialogid == DIALOG_GIVEINV)
    {
        if (response)
        {
            // Process input if the player pressed "Give"
            new targetid = strval(inputtext);

            if (IsPlayerConnected(targetid) && targetid != playerid)
            {
                // Get player positions
                new Float:x1, Float:y1, Float:z1;
                new Float:x2, Float:y2, Float:z2;

                GetPlayerPos(playerid, x1, y1, z1); // Get position of the player
                GetPlayerPos(targetid, x2, y2, z2); // Get position of the target player

                // Calculate distance between the two players
                new Float:distance = floatsqroot((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1) + (z2 - z1) * (z2 - z1));

                if (distance <= 5.0) // Check if the distance is within 5 units
                {
                    if(selectedItem[playerid] == -1) return SendClientMessage(playerid, COLOR_WHITE, "You did not select any items to give out.");
					if(targetid != -1)
					{
						if(IsOldWeaponModel(InventoryData[playerid][selectedItem[playerid]][invModel])) {
							Inventory_Add(targetid, InventoryData[playerid][selectedItem[playerid]][invItem], InventoryData[playerid][selectedItem[playerid]][invModel], InventoryData[playerid][selectedItem[playerid]][invQuantity]);
							Inventory_RemoveEx(playerid, selectedItem[playerid], InventoryData[playerid][selectedItem[playerid]][invQuantity]);
							//ShowAddItemNotification(targetid, InventoryData[playerid][selectedItem[playerid]][invItem], InventoryData[playerid][selectedItem[playerid]][invModel]);
							//ShowAddItemNotification(playerid, selectedItem[playerid], InventoryData[playerid][selectedItem[playerid]][invModel]);
						} 
						else {
							if(!AmountPlaced[playerid]) return SendClientMessage(playerid, COLOR_WHITE, "You did not input any amount to give please specify it.");
							Inventory_Add(targetid, InventoryData[playerid][selectedItem[playerid]][invItem], InventoryData[playerid][selectedItem[playerid]][invModel], AmountPlaced[playerid]);
							Inventory_RemoveEx(playerid, selectedItem[playerid], AmountPlaced[playerid]);
							//ShowAddItemNotification(targetid, InventoryData[playerid][selectedItem[playerid]][invItem], InventoryData[playerid][selectedItem[playerid]][invModel]);
							//ShowAddItemNotification(playerid, selectedItem[playerid], InventoryData[playerid][selectedItem[playerid]][invModel]);
						}
						SendClientMessage(playerid, COLOR_YELLOW, "DEBUG: Item given.");
						SendClientMessage(targetid, COLOR_YELLOW, "DEBUG: Item received.");
						ApplyAnimationEx(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0);
						ApplyAnimationEx(targetid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0);
						SetTimerEx("GiveAnimation", 700, false, "i", playerid);
						SetTimerEx("GiveAnimation", 700, false, "i", targetid);
						new string[128];
						format(string, sizeof(string),"%s gave %s a %s.", GetRPName(playerid), GetRPName(targetid), InventoryData[playerid][selectedItem[playerid]][invItem]);
						//DCC_SendChannelMessage(Give_Channel,string);
					}
					HidePlayerInventory(playerid);
					HidePlayerInventory(targetid);
                }
                else
                {
                    SendClientMessage(playerid, COLOR_RED, "The player is not close enough. Move closer to them.");
                }
            }
            else
            {
                SendClientMessage(playerid, COLOR_RED, "Invalid player ID.");
            }
        }
        else
        {
            // Player pressed "Cancel"
            SendClientMessage(playerid, COLOR_YELLOW, "You canceled the action.");
        }
	}
