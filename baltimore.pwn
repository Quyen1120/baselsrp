				}
				case 1: 
				{
					if(!CarToysAccess[carid]) 
						return SCM(playerid, COLOR_ERROR, "This vehicle does not have access in vehicle toys feature!");

					SetPVarInt(playerid, "CarToyAction", listitem);
					ShowCarToyEditMenu(playerid);
				}
