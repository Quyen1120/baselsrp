CMD:flashlight(playerid, params[])
{
	if(flashlight==0)
	{
		if(flashlightonhands[playerid] == 1){
			if(!Inventory_HasItem(playerid, "Flashlight"))		return SendMessage(playerid, COLOR_ERROR, "You don't have a Flashlight in your inventory.");
			if(IsPlayerInRangeOfPoint(playerid, 100.0, 771.7793, 5.4092, 1000.7802))
			{
				return SendMessage(playerid, COLOR_ERROR, "You can't use flashlight in the gym.");
			}
			SetPlayerAttachedObject(playerid, 8,18656, 5, 0.1, 0.038, -0.1, -90, 180, 0, 0.03, 0.03, 0.03);
			SetPlayerAttachedObject(playerid, 9,18641, 5, 0.1, 0.02, -0.05, 0, 0, 0, 1, 1, 1);
			flashlight=1;
		}
		return 1;
	}
	else if(flashlight==1)
	{
		if(flashlightonhands[playerid] == 1){
			if(IsPlayerInRangeOfPoint(playerid, 100.0, 771.7793, 5.4092, 1000.7802))
			{
				return SendMessage(playerid, COLOR_ERROR, "You can't use flashlight in the gym.");
			}
			if(!Inventory_HasItem(playerid, "Flashlight"))		return SendMessage(playerid, COLOR_ERROR, "You don't have a Flashlight in your inventory.");
			SetPlayerAttachedObject(playerid, 8,18656, 5, 0.1, 0.038, -0.01, -90, 180, 0, 0.03, 0.1, 0.03);
			SetPlayerAttachedObject(playerid, 9,18641, 5, 0.1, 0.02, -0.05, 0, 0, 0, 1, 1, 1);
			flashlight=2;
		}
		return 1;
	}
	else if(flashlight==2)
	{
		if(flashlightonhands[playerid] == 1){
			if(IsPlayerInRangeOfPoint(playerid, 100.0, 771.7793, 5.4092, 1000.7802))
			{
				return SendMessage(playerid, COLOR_ERROR, "You can't use flashlight in the gym.");
			}
			if(!Inventory_HasItem(playerid, "Flashlight"))		return SendMessage(playerid, COLOR_ERROR, "You don't have a Flashlight in your inventory.");
			RemovePlayerAttachedObject(playerid,8);
			RemovePlayerAttachedObject(playerid,9);
			flashlight=0;
		}
		return 1;
	}
	return 1;
}

CMD:toll(playerid, params[])
{
	if(!IsLawEnforcement(playerid) && GetFactionType(playerid) != FACTION_DOC && GetFactionType(playerid) != FACTION_GOVERNMENT)
		return SCM(playerid, COLOR_ERROR, "You are not part of a law enforcement faction.");

	if(Toll)
	{
		Toll = 0;

		foreach(new i : Player)
		{
			if((!pData[i][pToggleRadio]) && (GetFactionType(i) == FACTION_POLICE || GetFactionType(i) == FACTION_SHERIFF || GetFactionType(i) == FACTION_MEDIC || GetFactionType(i) == FACTION_GOVERNMENT || GetFactionType(i) == FACTION_FEDERAL || GetFactionType(i) == FACTION_NEWS || GetFactionType(i) == FACTION_DOC))
			{
				SCMf(i, SERVER_COLOR, "[DISPATCH] Attention All Units. The Toll Bridges have been shutdown on behalf of %s %s of the %s.", FactionRanks[pData[playerid][pFaction]][pData[playerid][pFactionRank]], GetRPName(playerid), FactionInfo[pData[playerid][pFaction]][fName]);
				SCMf(i, SERVER_COLOR, "[DISPATCH] All Non-Government traffic will not be permitted through.");
			}
		}
	}
	else
	{
		Toll = 1;

		foreach(new i : Player)
		{
			if((!pData[i][pToggleRadio]) && (GetFactionType(i) == FACTION_POLICE || GetFactionType(i) == FACTION_SHERIFF || GetFactionType(i) == FACTION_MEDIC || GetFactionType(i) == FACTION_GOVERNMENT || GetFactionType(i) == FACTION_FEDERAL || GetFactionType(i) == FACTION_NEWS || GetFactionType(i) == FACTION_DOC))
			{
				SCMf(i, SERVER_COLOR, "[DISPATCH] Attention All Units. The Toll Bridges have been re-opened on behalf of %s %s of the %s.", FactionRanks[pData[playerid][pFaction]][pData[playerid][pFactionRank]], GetRPName(playerid), FactionInfo[pData[playerid][pFaction]][fName]);
				SCMf(i, SERVER_COLOR, "[DISPATCH] All vehicle traffic may resume as normal.");
			}
		}
	}
	return 1;
}

CMD:pass(playerid, params[])
{
	new cashhy=150;
	if(pData[playerid][pCash] < cashhy)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You don't have enough money to pay for the toll");
	}
 	if (IsPlayerInRangeOfPoint(playerid, 7, 1813.34851, 813.63531, 10.66680))
	{
		if(Border11 == 1) { SCM(playerid, COLOR_GREY, "** Contact a developer"); return 1; }
   		DestroyDynamicObject( Border1 );
 		Border111 = CreateDynamicObject(968, 1813.34851, 813.63531, 10.66680,   0.00000, 0.00000, 0.00000);
 		SetTimerEx("Toll_G", 5000, false, "i", playerid);
   		SCM(playerid, SERVER_COLOR,"Toll Guard: {FFFFFF}The toll is now open, you have 5 seconds to pass through it.");
