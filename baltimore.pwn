					format(string, sizeof(string), "%i", InventoryData[playerid][selectedItem[playerid]][invQuantity]);
					PlayerTextDrawHide(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
					PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
				}
				

				format(string, sizeof(string), "%s", InventoryData[playerid][selectedItem[playerid]][invItem]);
				OnPlayerUseItem(playerid, string, selectedItem[playerid]);
			}
		}	
		if(playertextid == gInventoryInteraction[playerid][3]) { // Drop
			if(selectedItem[playerid] != -1) {
				if(IsOldWeaponModel(InventoryData[playerid][selectedItem[playerid]][invModel])) {
					OldDropPlayerItem(playerid, selectedItem[playerid], InventoryData[playerid][selectedItem[playerid]][invQuantity]);
				}
				if(CompareStrings("Phone", InventoryData[playerid][selectedItem[playerid]][invItem])) {
					OldDropPlayerItem(playerid, selectedItem[playerid], InventoryData[playerid][selectedItem[playerid]][invQuantity]);
				}
				else if(!IsOldWeaponModel(InventoryData[playerid][selectedItem[playerid]][invModel])){
					if(!AmountPlaced[playerid]) return SendMessage(playerid, COLOR_ERROR, "You did not input any amount to drop please specify it.");
					if(AmountPlaced[playerid] > InventoryData[playerid][selectedItem[playerid]][invQuantity]) return SendMessage(playerid, COLOR_ERROR, "You don't have that enough amount to drop.");

					OldDropPlayerItem(playerid, selectedItem[playerid], AmountPlaced[playerid]);
					AmountPlaced[playerid] = 0;
				}
				
				if(InventoryData[playerid][selectedItem[playerid]][invQuantity] == AmountPlaced[playerid] || IsOldWeaponModel(InventoryData[playerid][selectedItem[playerid]][invModel])) {
					PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 19300);
					PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 30);
					PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][selectedItem[playerid]], " ");
					PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], " ");
					PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]], false);
					PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][selectedItem[playerid]]);
					PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
					PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
				} else {
					format(string, sizeof(string), "%i", InventoryData[playerid][selectedItem[playerid]][invQuantity]);
					PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]], 30);
					PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][selectedItem[playerid]], string);
					PlayerTextDrawHide(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
					PlayerTextDrawShow(playerid, gInventoryQuantity[playerid][selectedItem[playerid]]);
					PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
					PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][selectedItem[playerid]]);
				}
				

				selectedItem[playerid] = -1;
			}
		}
		if(playertextid == gInventoryInteraction[playerid][4]) // Place Gun
		{
			if (pData[playerid][pHoldWeapon]) {
				PlaceGun(playerid);
			}
		}
		SetTimerEx("WeaponUpdate", 1000, true, "i", playerid);
	}
	return 1;
}
