CMD:myangle(playerid, params[])
{
    new myString[128], Float:a;
    GetPlayerFacingAngle(playerid, a);

    format(myString, sizeof(myString), "```Your angle is: %0.2f```", a);
    SendClientMessage(playerid, 0xFFFFFFFF, myString);

    new szString[128], Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    format(szString, sizeof(szString), "```Your position is: %f, %f, %f```", x, y, z);
    SendClientMessage(playerid, 0xFFFFFFFF, szString);
/*
	format(myString, sizeof(myString),"%f, %f, %f, %0.2f", x, y, z, a);
	//DCC_SendChannelMessage(Myanglelog_Channel,myString);*/
    return 1;
}
