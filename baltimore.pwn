	}
	else if(pData[playerid][pFaction] == 5)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP BJMP");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_GREEN);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 1)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP SERVER MODERATOR");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 2)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP JUNIOR ADMINISTRATOR");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 3)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP GENERAL ADMINISTRATOR");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 4)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP SENIOR ADMINISTRATOR");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 5)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP HEAD ADMINISTRATOR");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 6)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP ASSISTANT MANAGEMENT");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else if(pData[playerid][pAdmin] == 7)
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "BH:RP COMMUNITY OWNER");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	else
	{
		PlayerTextDrawHide(playerid, PlayerStatsTD[playerid]);
		format(string, sizeof(string), "Citizen");
		PlayerTextDrawColor(playerid, PlayerStatsTD[playerid], COLOR_YELLOW);
		PlayerTextDrawShow(playerid, PlayerStatsTD[playerid]);
	}
	PlayerTextDrawSetString(playerid, PlayerStatsTD[playerid], string);
	return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result == -1)
	{
		Harmony(playerid, "Unknown Command", "Please use /help", 3);
		PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
	}
	new cmdd[32];
//    new params[128];
    sscanf(cmd, "s[32]s[128]", cmdd, params);
	printf("[cmd] [%s]: %s (%s)", GetRPName(playerid), cmdd, (result ? ("success") : ("unknown")));
	return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if((newkeys & KEY_NO)) // Enter
    {
