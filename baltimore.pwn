forward StandUp(playerid);
public StandUp(playerid)
{
    ApplyAnimation(playerid, "PED", "null", 0.0, 0, 0, 0, 0, 0);
    ApplyAnimation(playerid, "PED", "getup_front", 4.0, 0, 0, 0, 0, 0);

    SetPlayerDrunkLevel(playerid, 0);
    return 1;
}

forward Vest1(playerid);
public Vest1(playerid)
{
	ClearAnimations(playerid);
    SetPlayerArmour(playerid, 75);
    GameTextForPlayer(playerid, "~g~equipped", 2000, 1);
    SetPlayerAttachedObject(playerid, 5, 19142, 1, 0.04, 0.05, 0, 0, 0, 1.2, 1.3, 1.2); 
	SendMessage(playerid, COLOR_WHITE, "You have equipped the vest.");
	TogglePlayerControllable(playerid, true);
	return 1;
}

forward Vest2(playerid);
public Vest2(playerid)
{
	ClearAnimations(playerid);
    //SetPlayerAttachedObject(playerid, 7, 19515, 1, 0.04, 0.05, 0, 0, 0, 1.2, 1.3, 1.2);
    SetPlayerAttachedObject(playerid, 5, 19515, 1, 0.04, 0.05, 0, 0, 0, 1.2, 1.3, 1.2);
    SetPlayerArmour(playerid, 45);
    GameTextForPlayer(playerid, "~g~equipped", 2000, 1);
	SendMessage(playerid, COLOR_WHITE, "You have equipped the vest.");
	TogglePlayerControllable(playerid, true);
	return 1;
}


CMD:setarmorall(playerid, params[])
{
	new Float:amount;

    if(pData[playerid][pAdmin] < 4)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(!pData[playerid][pAdminDuty] && pData[playerid][pAdmin] < 5)
	{
	    return SCM(playerid, COLOR_SYNTAX, "This command requires you to be on admin duty. /aduty to go on duty.");
	}
	if(sscanf(params, "f", amount))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /setarmorall [amount]");
	}
	if(amount < 0.0 || amount > 150.0)
	{
	    return SCM(playerid, COLOR_SYNTAX, "Armor can't be under 0.0 or above 150.0.");
	}

	foreach(new i : Player)
	{
	    SetScriptArmour(i, amount);
	}

	SAM(COLOR_TEAL, "AdmCmd:"WHITE" %s set everyone's armor to %.1f.", GetRPName(playerid), amount);
	return 1;
}

CMD:takethetrip(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0,
    1975.205810, -2312.069335, 13.546875))
    {
        return SendClientMessage(playerid,
        0xAFAFAFAA,
        "You are not in the LS Airport.");
    }

    TogglePlayerControllable(playerid, 0);

    // Plane interior
    SetPlayerInterior(playerid, 1);
    SetPlayerVirtualWorld(playerid, 0);

    // Seat position
    SetPlayerPos(playerid,
    2.5091,
    33.7417,
    1199.5937);

    SetPlayerFacingAngle(playerid, 270.0);

    // Sitting animation
    ApplyAnimation(playerid,
    "PED",
    "seat_idle",
    4.1,
    1,
    0,
    0,
    1,
    0,
    1);

    GameTextForPlayer(playerid,
    "~w~Flying to Liberty City...",
    10000,
    3);

    // 10 seconds
    SetTimerEx("FinishTrip", 10000, false, "i", playerid);

    return 1;
}

CMD:travelback(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0,
    -794.103759, 483.786376, 1388.049682))
    {
        return SendClientMessage(playerid,
        0xAFAFAFAA,
        "You are not in Liberty City Airport.");
    }

    TogglePlayerControllable(playerid, 0);

    SetPlayerInterior(playerid, 1);
    SetPlayerVirtualWorld(playerid, 0);

    SetPlayerPos(playerid,
    2.5091,
    33.7417,
    1199.5937);

    SetPlayerFacingAngle(playerid, 270.0);

    ApplyAnimation(playerid,
    "PED",
    "seat_idle",
    4.1,
    1,
    0,
    0,
    1,
    0,
    1);

    GameTextForPlayer(playerid,
    "~w~Flying to Los Santos...",
    10000,
    3);

    SetTimerEx("FinishTripBack", 10000, false, "i", playerid);

    return 1;
}

public FinishTrip(playerid)
{
    SetPlayerInterior(playerid, 1);
    SetPlayerVirtualWorld(playerid, 0);

    SetPlayerPos(playerid,
    -794.103759,
    483.786376,
    1388.049682);

    SetPlayerFacingAngle(playerid, 180.0);

    SetCameraBehindPlayer(playerid);

    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);

    GameTextForPlayer(playerid,
    "~g~Welcome to Liberty City",
    4000,
    3);

    return 1;
}

public FinishTripBack(playerid)
{
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);

    SetPlayerPos(playerid,
    1975.205810,
    -2312.069335,
    13.546875);

    SetPlayerFacingAngle(playerid, 180.0);

    SetCameraBehindPlayer(playerid);

    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);

    GameTextForPlayer(playerid,
    "~g~Welcome to Los Santos",
    4000,
    3);

    return 1;
}


