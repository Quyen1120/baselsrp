CMD:clearinventory(playerid, params[])
{
	new targetid;
	if(pData[playerid][pAdmin] < 8)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You are not authorized to use this command.");
	}
	//if(!IsAdmin(playerid, SENIOR_ADMINISTRATOR)) return SendMessage(playerid, COLOR_ERROR, "You are not authorized to use this command.");
    if (sscanf(params, "i", targetid)) return SendMessage(playerid, COLOR_WHITE, "/clearinventory [targetid]");
//    if(!IsPlayerOnline(targetid))               return SendMessage(playerid, COLOR_ERROR, "That player is not yet online.");

	SendAdminMessage(COLOR_RED, "ADMCMD:"COL_WHITE" %s removed all the inventory items of %s.", GetRPName(playerid), GetRPName(targetid));
	SendMessage(targetid, COLOR_WHITE, "%s removed all your items in the inventory.", GetRPName(playerid));

	Inventory_Clear(targetid);
//	LoadHolsters(targetid);
	return 1;
}

stock Inventory_Set(playerid, const item[], model, amount)
{
	new itemid = Inventory_GetItemID(playerid, item);

	if (itemid == -1 && amount > 0)
		Inventory_Add(playerid, item, model, amount);

	else if (amount > 0 && itemid != -1)
	    Inventory_SetQuantityEx(playerid, item, amount);

	else if (amount < 1 && itemid != -1)
	    Inventory_Remove(playerid, item, -1);

	return 1;
}

stock Inventory_GetItemID(playerid, const item[])
{
	for (new i = 0; i < MAX_INVENTORY; i ++)
	{
	    if (!InventoryData[playerid][i][invExists])
	        continue;

		if (!strcmp(InventoryData[playerid][i][invItem], item)) return i;
	}
	return -1;
}

stock Inventory_GetItemIDEx(playerid, const item[])
{
    for (new i = 0; i < MAX_INVENTORY; i++)
    {
        if (!InventoryData[playerid][i][invExists])
            continue;

        if (!strcmp(InventoryData[playerid][i][invItem], item))
        {
            return i;
        }
    }
    return -1;
}

stock Inventory_GetFreeID(playerid)
{
	if (Inventory_Items(playerid) >= 20)
		return -1;

	for (new i = 0; i < MAX_INVENTORY; i ++)
	{
	    if (!InventoryData[playerid][i][invExists])
	        return i;
	}
	return -1;
}

stock Inventory_Items(playerid)
{
    new count;

    for (new i = 0; i != MAX_INVENTORY; i ++) if (InventoryData[playerid][i][invExists]) {
        count++;
	}
	return count;
}

stock Inventory_Count(playerid, const item[])
{
	new itemid = Inventory_GetItemID(playerid, item);

	if (itemid != -1)
	    return InventoryData[playerid][itemid][invQuantity];

	return 0;
}

stock PlayerHasItem(playerid, item[])
{
	return (Inventory_GetItemID(playerid, item) != -1);
}

stock PlayerHasItemSD(playerid)
{
	return (Inventory_GetItemID(playerid, item) != -1);
}

stock Inventory_HasItem(playerid, const item[])
{
	return (Inventory_GetItemID(playerid, item) != -1);
}

stock Inventory_SetQuantity(playerid, const item[], quantity)
{
	new
	    itemid = Inventory_GetItemID(playerid, item),
	    string[128];

	if (itemid != -1)
	{
	    format(string, sizeof(string), "UPDATE `newinventory` SET `invQuantity` = %d WHERE `ownerID` = '%d' AND `invID` = '%d'", quantity, pData[playerid][pID], InventoryData[playerid][itemid][invID]);
	    mysql_tquery(connectionID, string);

	    InventoryData[playerid][itemid][invQuantity] = quantity;
	}
	return 1;
}

stock Inventory_SetQuantityEx(playerid, const item[], quantity)
{
	new
	    itemid = Inventory_GetItemID(playerid, item);

	if (itemid != -1)
	{
		InventoryData[playerid][itemid][invQuantity] += quantity;

		mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE `newinventory` SET `invQuantity` = %d WHERE `ownerID` = '%d' AND `invID` = '%d'", InventoryData[playerid][itemid][invQuantity], pData[playerid][pID], InventoryData[playerid][itemid][invID]);
	    mysql_tquery(connectionID, queryBuffer);
	}
	return 1;
}

forward RemoveItemNotification(playerid);
public RemoveItemNotification(playerid)
{
	ShowingItemNotification[playerid] = 0;
    PlayerTextDrawDestroy(playerid, ItemNotifcationPTD[playerid][0]);
	PlayerTextDrawDestroy(playerid, ItemNotifcationPTD[playerid][1]);
	PlayerTextDrawDestroy(playerid, ItemNotifcationPTD[playerid][2]);
}

stock Inventory_Add(playerid, const item[], model, quantity = 1)
{
	new string[128], itemid = Inventory_GetFreeID(playerid);

    if (itemid != -1)
    {
		ShowAddItemNotification(playerid, item, model);
        InventoryData[playerid][itemid][invExists] = true;
        InventoryData[playerid][itemid][invModel] = model;
        InventoryData[playerid][itemid][invQuantity] = quantity;

        strcpy(InventoryData[playerid][itemid][invItem], item, 128);
        //strpack(InventoryData[playerid][itemid][invItem], item, 32 char);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO `newinventory` (ownerID, invItem, invModel, invQuantity, slot) VALUES(%d, '%e', %d, %d, %d)", pData[playerid][pID], InventoryData[playerid][itemid][invItem], model, quantity, itemid);
        mysql_tquery(connectionID, queryBuffer, "OnInventoryAdd", "dd", playerid, itemid);

		if(ShowingInventory[playerid]) {
			PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][itemid], InventoryData[playerid][itemid][invModel]);
			PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][itemid], 30);
			PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][itemid], InventoryData[playerid][itemid][invItem]);
			format(string, sizeof(string), "%i", InventoryData[playerid][itemid][invQuantity]);
			PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][itemid], string);
			PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][itemid], true);
			PlayerTextDrawShow(playerid, gInventoryItemName[playerid][itemid]);
			PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][itemid]);
			PlayerTextDrawShow(playerid, g_InventoryGreenBox[playerid][itemid]);
		}
		return 1;
    }
	else if(itemid == -1)
	{
		return SendMessage(playerid, COLOR_WHITE, "Your Inventory is full");
	}
	return 1;
}

stock Inventory_AddEx(playerid, const item[], model, quantity, itemid)
{
	new string[128];
	InventoryData[playerid][itemid][invExists] = true;
	InventoryData[playerid][itemid][invModel] = model;
	InventoryData[playerid][itemid][invQuantity] = quantity;

	//strpack(InventoryData[playerid][itemid][invItem], item, 32 char);

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO newinventory (ownerID, invItem, invModel, invQuantity, slot) VALUES(%d, '%e', %d, %d, %d)", pData[playerid][pID], item, model, quantity, itemid);
	mysql_tquery(connectionID, queryBuffer, "OnInventoryAdd", "dd", playerid, itemid);

	return 1;
}

stock Inventory_Remove(playerid, const item[], quantity = 1)
{
	new
		itemid = Inventory_GetItemID(playerid, item),
		string[128];

	if (itemid != -1)
	{
	    if (InventoryData[playerid][itemid][invQuantity] > 0)
	    {
	        InventoryData[playerid][itemid][invQuantity] -= quantity;
		}
		if (quantity == -1 || InventoryData[playerid][itemid][invQuantity] < 1)
		{
		    InventoryData[playerid][itemid][invExists] = false;
		    InventoryData[playerid][itemid][invModel] = 0;
		    InventoryData[playerid][itemid][invQuantity] = 0;

		    format(string, sizeof(string), "DELETE FROM `newinventory` WHERE `ownerID` = '%d' AND `invID` = '%d'", pData[playerid][pID], InventoryData[playerid][itemid][invID]);
	        mysql_tquery(connectionID, string);
		}
		else if (quantity != -1 && InventoryData[playerid][itemid][invQuantity] > 0)
		{
			format(string, sizeof(string), "UPDATE `newinventory` SET `invQuantity` = `invQuantity` - %d WHERE `ownerID` = '%d' AND `invID` = '%d'", quantity, pData[playerid][pID], InventoryData[playerid][itemid][invID]);
            mysql_tquery(connectionID, string);
		}
		return 1;
	}
	return 0;
}

stock Inventory_RemoveEx(playerid, itemid, quantity)
{
	new string[128];
	// InventoryData[playerid][itemid][invExists] = false;
	// InventoryData[playerid][itemid][invModel] = 0;
	// InventoryData[playerid][itemid][invQuantity] = 0;
	// strcpy(InventoryData[playerid][itemid][invItem], "");

	// format(string, sizeof(string), "DELETE FROM `newinventory` WHERE `ownerID` = '%d' AND `invID` = '%d'", pData[playerid][pID], InventoryData[playerid][itemid][invID]);
	// mysql_tquery(connectionID, string);

	if (InventoryData[playerid][itemid][invQuantity] > 0)
	{
		InventoryData[playerid][itemid][invQuantity] -= quantity;
	}
	if (quantity == -1 || InventoryData[playerid][itemid][invQuantity] < 1)
	{
		InventoryData[playerid][itemid][invExists] = false;
		InventoryData[playerid][itemid][invModel] = 0;
		InventoryData[playerid][itemid][invQuantity] = 0;

		format(string, sizeof(string), "DELETE FROM `newinventory` WHERE `ownerID` = '%d' AND `invID` = '%d'", pData[playerid][pID], InventoryData[playerid][itemid][invID]);
		mysql_tquery(connectionID, string);
	}
	else if (quantity != -1 && InventoryData[playerid][itemid][invQuantity] > 0)
	{
		format(string, sizeof(string), "UPDATE `newinventory` SET `invQuantity` = `invQuantity` - %d WHERE `ownerID` = '%d' AND `invID` = '%d'", quantity, pData[playerid][pID], InventoryData[playerid][itemid][invID]);
		mysql_tquery(connectionID, string);
	}
	return 1;
}


#include <YSI_Game\y_weapondata>

PlaceGun(playerid)
{
	new raw_slot = Weapon_GetSlot(pData[playerid][pHoldWeapon]), weapons[2];
	GetPlayerWeaponData(playerid, WEAPON_SLOT:raw_slot, WEAPON:weapons[0], weapons[1]);

	Inventory_Add(playerid, ReturnWeaponName(WEAPON:pData[playerid][pHoldWeapon]), weaponModelIDsss[pData[playerid][pHoldWeapon]], weapons[1]);
	pData[playerid][pPlayerAmmo] = 0;
	pData[playerid][pHoldWeapon] = 0;
	pData[playerid][pPlayerLaser] = 0;
	ResetPlayerWeapons(playerid);

	RemovePlayerAttachedObject(playerid,7);
	RemovePlayerAttachedObject(playerid,8);

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET holdweapon = %i, playerammo = %i WHERE uid = %i", pData[playerid][pHoldWeapon], pData[playerid][pPlayerAmmo], pData[playerid][pID]);
	mysql_tquery(connectionID, queryBuffer);

	if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) 	RemovePlayerAttachedObject(playerid, 4);
	if (IsPlayerAttachedObjectSlotUsed(playerid, 9))	RemovePlayerAttachedObject(playerid, 9);

	return 1;
}

StackItems(playerid, item1, item2) 
{
	if (InventoryData[playerid][item2][invExists]) {
		new string[128];

		// Old Item Reset sa blank
		PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][item1], 19300);
		PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][item1], " ");
		PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][item1], " ");
		PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][item1], false);
		PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][item1]);
		PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][item1]);
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][item1]);


		// Transfer the stats of item1 to item 2
		//InventoryData[playerid][item2][invID] = InventoryData[playerid][item1][invID];
		InventoryData[playerid][item2][invExists] = true;
		InventoryData[playerid][item2][invModel] = InventoryData[playerid][item1][invModel];
		InventoryData[playerid][item2][invQuantity] = InventoryData[playerid][item2][invQuantity] + InventoryData[playerid][item1][invQuantity];

		// Reset the Item1 variables
		InventoryData[playerid][item1][invExists] = false;
		InventoryData[playerid][item1][invModel] = 0;
		InventoryData[playerid][item1][invQuantity] = 0;


		format(string, sizeof(string), "%i", InventoryData[playerid][item2][invQuantity]);

		PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][item2], InventoryData[playerid][item2][invModel]);
		PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][item2], -1523963217);
		PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][item2], InventoryData[playerid][item2][invItem]);
		PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][item2], string);
		PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][item2], true);
		PlayerTextDrawShow(playerid, gInventoryItemName[playerid][item2]);
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][item2]);
		PlayerTextDrawShow(playerid, g_InventoryGreenBox[playerid][item2]);

		selectedItem[playerid] = item2;
		mysql_format(connectionID, string, sizeof(string), "UPDATE newinventory SET invQuantity = %i WHERE ownerID = %i AND invID = %i", InventoryData[playerid][item2][invQuantity], pData[playerid][pID], InventoryData[playerid][item2][invID]);
	    mysql_tquery(connectionID, string);

		Inventory_RemoveEx(playerid, item1, -1);

		//Inventory_AddEx(playerid, InventoryData[playerid][item2][invItem], InventoryData[playerid][item2][invModel], InventoryData[playerid][item2][invQuantity], item2);
		//Inventory_RemoveEx(playerid, InventoryData[playerid][item1][invItem], item1);
	}
	return 1;
}

MoveItemToSelectedSlot(playerid, item1, item2) 
{
	new string[128];
	new item1Model = InventoryData[playerid][item1][invModel];
	new item1Quantity = InventoryData[playerid][item1][invQuantity];
	new item1invID = InventoryData[playerid][item1][invID];
	new item1Item[128];

	strcpy(item1Item, InventoryData[playerid][item1][invItem]);

	if (!InventoryData[playerid][item2][invExists]) {
		// Old Item Reset sa blank
		PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][item1], 19300);
		PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][item1], " ");
		PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][item1], " ");
		PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][item1], false);
		PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][item1]);
		PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][item1]);
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][item1]);


		// Transfer the stats of item1 to item 2
		InventoryData[playerid][item2][invID] = InventoryData[playerid][item1][invID];
		InventoryData[playerid][item2][invExists] = true;
		InventoryData[playerid][item2][invModel] = InventoryData[playerid][item1][invModel];
		InventoryData[playerid][item2][invQuantity] = InventoryData[playerid][item1][invQuantity];

		// Reset the Item1 variables
		InventoryData[playerid][item1][invExists] = false;
		InventoryData[playerid][item1][invModel] = 0;
		InventoryData[playerid][item1][invQuantity] = 0;

		strcpy(InventoryData[playerid][item2][invItem], InventoryData[playerid][item1][invItem], 128);

		format(string, sizeof(string), "%i", InventoryData[playerid][item2][invQuantity]);

		PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][item2], InventoryData[playerid][item2][invModel]);
		PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][item2], -1523963217);
		PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][item2], InventoryData[playerid][item2][invItem]);
		PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][item2], string);
		PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][item2], true);
		PlayerTextDrawShow(playerid, gInventoryItemName[playerid][item2]);
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][item2]);
		PlayerTextDrawShow(playerid, g_InventoryGreenBox[playerid][item2]);

		selectedItem[playerid] = item2;
		mysql_format(connectionID, string, sizeof(string), "UPDATE newinventory SET slot = %i WHERE ownerID = %i AND invID = %i", item2, pData[playerid][pID], InventoryData[playerid][item2][invID]);
	    mysql_tquery(connectionID, string);
		//Inventory_AddEx(playerid, InventoryData[playerid][item2][invItem], InventoryData[playerid][item2][invModel], InventoryData[playerid][item2][invQuantity], item2);
		//Inventory_RemoveEx(playerid, InventoryData[playerid][item1][invItem], item1);
	} else {

		InventoryData[playerid][item1][invExists] = true;
		InventoryData[playerid][item1][invModel] = InventoryData[playerid][item2][invModel];
		InventoryData[playerid][item1][invQuantity] = InventoryData[playerid][item2][invQuantity];
		InventoryData[playerid][item1][invID] = InventoryData[playerid][item2][invID];

		strcpy(InventoryData[playerid][item1][invItem], InventoryData[playerid][item2][invItem]);
		format(string, sizeof(string), "%i", InventoryData[playerid][item1][invQuantity]);

		PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][item1], InventoryData[playerid][item1][invModel]);
		//PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][item1], -1523963217);
		PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][item1], InventoryData[playerid][item1][invItem]);
		PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][item1], string);
		PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][item1], true);
		PlayerTextDrawShow(playerid, gInventoryItemName[playerid][item1]);
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][item1]);
		PlayerTextDrawShow(playerid, g_InventoryGreenBox[playerid][item1]);
		selectedItem[playerid] = -1;

		InventoryData[playerid][item2][invExists] = true;
		InventoryData[playerid][item2][invModel] = item1Model;
		InventoryData[playerid][item2][invQuantity] = item1Quantity;
		InventoryData[playerid][item2][invID] = item1invID;

		strcpy(InventoryData[playerid][item2][invItem], item1Item);

		format(string, sizeof(string), "%i", InventoryData[playerid][item2][invQuantity]);

		PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][item2], InventoryData[playerid][item2][invModel]);
		//PlayerTextDrawBackgroundColor(playerid, g_InventoryPreviewModel[playerid][item2], -1523963217);
		PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][item2], InventoryData[playerid][item2][invItem]);
		PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][item2], string);
		PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][item2], true);
		PlayerTextDrawShow(playerid, gInventoryItemName[playerid][item2]);
		PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][item2]);
		PlayerTextDrawShow(playerid, g_InventoryGreenBox[playerid][item2]);

		// Item 1
		mysql_format(connectionID, string, sizeof(string), "UPDATE newinventory SET slot = %i WHERE ownerID = %i AND invID = %i", item1, pData[playerid][pID], InventoryData[playerid][item1][invID]);
	    mysql_tquery(connectionID, string);

		// Item 2
		mysql_format(connectionID, string, sizeof(string), "UPDATE newinventory SET slot = %i WHERE ownerID = %i AND invID = %i", item2, pData[playerid][pID], InventoryData[playerid][item2][invID]);
	    mysql_tquery(connectionID, string);
	}
	return 1;
}
