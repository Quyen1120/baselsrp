GetNearbyPlayerID(playerid, Float:range)
{
	new closestid = -1;
	foreach(new i : Player)
	{
		if(IsPlayerInRangeOfPlayer(i, playerid, range))
		{
		    if(pData[i][pCuffed] == 1)
		    {
				if(i == playerid) {
					closestid = -1;
					return closestid;
				} 
			    closestid = i;
			}
		}
	}
	return closestid;
}

