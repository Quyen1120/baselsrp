CreateFreeBMX(playerid)
{
	new model[20], modelid, targetid, color1, color2, Float:x, Float:y, Float:z, Float:a;
	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO vehicles (ownerid, owner, modelid, pos_x, pos_y, pos_z, pos_a, color1, color2) VALUES(%i, '%s', %i, '%f', '%f', '%f', '%f', %i, %i)", pData[playerid][pID], GetPlayerNameEx(playerid), 481, x + 2.0 * floatsin(-a, degrees), y + 2.0 * floatcos(-a, degrees), z, a, color1, color2);
	mysql_tquery(connectionID, queryBuffer);


    SendMessage(playerid, COLOR_WHITE, "As it is your first time spawning on the server. We have given you a free BMX as a starter vehicle.");
    SendMessage(playerid, COLOR_WHITE, "It is parked at the nearest vehicle garage.");
}

