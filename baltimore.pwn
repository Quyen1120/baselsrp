	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2227.6055,-2263.9524,14.1816,45.9869,1,1,360); // 4
	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2212.0391,-2280.2217,14.1813,45.7099,1,1,360); // 5
	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2208.7568,-2283.3406,14.1798,45.4458,1,1,360); // 6
	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2205.4792,-2286.7327,14.1757,46.7885,1,1,360); // 7
	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2202.1709,-2290.0400,14.1722,46.0170,1,1,360); // 8
	CreateTruckBody(tmpveh);
