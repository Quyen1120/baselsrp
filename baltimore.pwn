            new startIndex = 0;

            for (new i = 0; i < paramLength; i++)
                if (inputtext[i] == '-' && i < paramLength - 1 && inputtext[i + 1] >= '0' && inputtext[i + 1] <= '9')
                {
                    startIndex = i + 1;
                    break;
                }

            if (startIndex < paramLength)
            {
                new extractedNumber[16], j = 0;
                for (new i = startIndex; i < paramLength && j < sizeof(extractedNumber) - 1; i++)
                {
                    if (inputtext[i] >= '0' && inputtext[i] <= '9')
                        extractedNumber[j++] = inputtext[i];
                    else
                        break;
                }
                extractedNumber[j] = '\0';

                sscanf(extractedNumber, "%d", carID);
                GetVehicleInfoFromDB(carID, playerid);
            }
            else
            {
                SendMessage(playerid, COLOR_WHITE, "Invalid plate number.");
