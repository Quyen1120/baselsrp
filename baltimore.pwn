	SM(ReportInfo[reportid][rReporter], COLOR_TEAL, "Please visit our rules page at "WHITE"("SERVER_URL")"TEAL" for a full list of rulebreaking offenses.");
	ReportInfo[reportid][rExists] = 0;
	return 1;
}

