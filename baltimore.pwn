forward LoadPlayerInventory(extraid);
public LoadPlayerInventory(extraid)
{
    static rows, fields;

//	static name[32];

	cache_get_data(rows, fields, connectionID);

	for (new i = 0; i < rows && i < MAX_INVENTORY; i ++) 
	{ 
		new id = cache_get_field_content_int(i, "slot");
		InventoryData[extraid][id][invExists] = true;
		InventoryData[extraid][id][invID] = cache_get_field_content_int(i, "invID");
		InventoryData[extraid][id][invModel] = cache_get_field_content_int(i, "invModel");
		InventoryData[extraid][id][invQuantity] = cache_get_field_content_int(i, "invQuantity");
		cache_get_field_content(i, "invItem", InventoryData[extraid][id][invItem]);
    }
    printf("MySQL Report: %s Inventory Loaded. [%d/20]", GetRPName(extraid), rows);
	return 1;
}

