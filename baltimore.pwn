			case SR_AMMO: if (!PlayerHasItem(playerid, "7.62x39mm")) return SendErrorMessage(playerid, "You don't have any Sniper ammo left to load your ammo cartridge.");
			case SG_AMMO: if (!PlayerHasItem(playerid, "12-gauge")) return SendErrorMessage(playerid, "You don't have any Shotgun ammo left to load your ammo cartridge.");
		}

