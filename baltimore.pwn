	if (CompareStrings("VVL", item)) {
        new car = GetNearbyVehicle(playerid);
        new Float:MechRotZ;
        if (car == INVALID_VEHICLE_ID) return SCM(playerid, COLOR_RED, "No valid vehicle nearby.");

        new factionType = FactionInfo[pData[playerid][pFaction]][fType];
        if (factionType != FACTION_MECHANIC) return SCM(playerid, COLOR_SYNTAX, "You must be a mechanic to use this command.");
        if (pData[playerid][pDuty] == 0) return SCM(playerid, COLOR_GREY2, "You can't use this command while off-duty.");
        if (GetVehicleParams(car, VEHICLE_ENGINE)) return SCM(playerid, COLOR_SYNTAX, "Turn off the engine first.");

        if(!IsPlayerNearVehiclePart(playerid, car, VEH_PART_HOOD, 1.0, 0.0))
        {
             return SCM(playerid,  COLOR_GREY2, "**Go to the front of the car to work on the camshaft.");
        }
        if(!GetVehicleParams(car, VEHICLE_BONNET))
        {
             return SCM(playerid,  COLOR_GREY2, "**Go inside the vehicle and open the hood.");
