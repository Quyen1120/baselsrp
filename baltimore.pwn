stock GivePlayerWeaponExx(playerid, weaponid, amount)
{
	// if (ValidWeaponForInventory(weaponid) == 0)	return 0;
	ResetPlayerWeapons(playerid);
	if (weaponid >= 41 && weaponid <= 46)
	{
		pData[playerid][pHoldWeapon]=weaponid;
		pData[playerid][pPlayerAmmo]=999;
		GiveWeapon(playerid, WEAPON:weaponid, 999);
		return 1;
	}
	
	pData[playerid][pHoldWeapon] = weaponid;
	pData[playerid][pPlayerAmmo] = amount;

	if (weaponid == 23 && amount == 999) return GiveWeapon(playerid, WEAPON:weaponid, amount);

	if (amount >= 1)
	{
		if (weaponid >= 22 && weaponid <= 34)
		{
            pData[playerid][pPlayerAmmo] = amount;
		}
	}

	if (IsPlayerAttachedObjectSlotUsed(playerid, 9))	RemovePlayerAttachedObject(playerid, 9);

	if (pData[playerid][pPlayerAmmo] != 0) 	GiveWeapon(playerid, WEAPON:weaponid, pData[playerid][pPlayerAmmo]);
	else 											SetPlayerAttachedObject(playerid, 9, Weapon_GetModelID(pData[playerid][pHoldWeapon]), 6, 0.0, 0.0, 0.0);

	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) 						SetPlayerArmedWeapon(playerid, 0);
	//if (GetPlayerState(playerid) == PLAYER_STATE_PASSENGER && weaponid == 24) 	SetPlayerArmedWeapon(playerid, 0);
	
	mysql_tquery(connectionID, "UPDATE users SET holdweapon = %i WHERE uid = %i", pData[playerid][pHoldWeapon], pData[playerid][pID]);
	mysql_tquery(connectionID, "UPDATE users SET playerammo = %i WHERE uid = %i", pData[playerid][pPlayerAmmo], pData[playerid][pID]);

	//LoadHolsters(playerid);
	return 1;
}

