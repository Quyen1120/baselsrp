public OnPlayerDisconnect(playerid, reason)
{
	if (lstream[playerid]) {
		SvDeleteStream(lstream[playerid]);
		lstream[playerid] = SV_NULL;
	}

	//car factory
	new veh_for_check;
	if(GetPVarInt(playerid, "veh_rent") != -1) {
		for(new i = 0, ps = GetVehiclePoolSize(); i <= ps; i++) {
			if(cargo_driver[i] != playerid) continue;
			veh_for_check = i;
			if(i == af_carID[playerid] && af_load[playerid]) 
				RemoveCarFromTruckBody(playerid);
			if(i >= af_orig_truck[0] && i <= af_orig_truck[1]) 
				SetVehicleToRespawn(i);
			else DestroyVehicle(i);
			break;
		}
		if(!IsValidVehicle(veh_for_check)) {
			cargo_driver[GetPVarInt(playerid, "veh_rent")] = -1;
			SetPVarInt(playerid, "veh_rent", -1);
		}
	}
	
	pData[playerid][pPlayerLaser] = 0;
	DeletePVar(playerid, "handsup");
	KillTimer(ProgresPlayerTimer[playerid]);
	HidePlayerInventory(playerid);
	TerminateInfo(playerid, reason);


	Iter_Clear(player_items[playerid]);
    for(new i = 0; i < 5; i ++) 
    {
        PlayerTextDrawDestroy(playerid, _@m_ptd[playerid][i]);
    }
    for(new i = 0; i < MENU_MAX_ITEM_PER_PAGE; i ++) 
    {
        if(_@m_item[playerid][i] != PlayerText:INVALID_TEXT_DRAW) 
        {
            PlayerTextDrawDestroy(playerid, _@m_item[playerid][i]);
            _@m_item[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        }               
        if(_@m_box[playerid][i] != PlayerText:INVALID_TEXT_DRAW) 
        {
            PlayerTextDrawDestroy(playerid, _@m_box[playerid][i]);
            _@m_box[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        }   
    }   

	if(kachall[playerid]!=-1){
    if(kachstatus[kachall[playerid]]==playerid) kachstatus[kachall[playerid]]=-1;
	kachall[playerid]=-1;}
	
	if(kach[playerid]==1){
    kach[playerid]=0;
    SetPlayerSkin(playerid, kachskin[playerid]);}
    
	if(baton[playerid] == 1)
	{
		baton[playerid] = 0;
		RemovePlayerAttachedObject(playerid,8);
		SendMessage(playerid, COLOR_WHITE, ""COL_RED"Spiked Bat Hidden.");
		pData[playerid][pPlayerAmmo] = 0;
		pData[playerid][pHoldWeapon] = 0;
		ResetPlayerWeapons(playerid);
		mysql_tquery(connectionID, "UPDATE users SET holdweapon = %i, playerammo = %i WHERE uID = %i", pData[playerid][pHoldWeapon], pData[playerid][pPlayerAmmo], pData[playerid][pID]);
		Inventory_Set(playerid, "Spiked Bat", 2045, 1);
	}

	if(bigbaton[playerid] == 1)
	{
		bigbaton[playerid] = 0;
		RemovePlayerAttachedObject(playerid,8);
		SendMessage(playerid, COLOR_WHITE, ""COL_RED"Baseball Bat Hidden.");
		pData[playerid][pPlayerAmmo] = 0;
		pData[playerid][pHoldWeapon] = 0;
		ResetPlayerWeapons(playerid);
		mysql_tquery(connectionID, "UPDATE users SET holdweapon = %i, playerammo = %i WHERE uID = %i", pData[playerid][pHoldWeapon], pData[playerid][pPlayerAmmo], pData[playerid][pID]);
		Inventory_Set(playerid, "Baseball Bat", 19914, 1);
	}

	if(hammeron[playerid] == 1)
	{
		hammeron[playerid] = 0;
		RemovePlayerAttachedObject(playerid,8);
		SendMessage(playerid, COLOR_WHITE, ""COL_RED"Hammer Hidden.");
		pData[playerid][pPlayerAmmo] = 0;
		pData[playerid][pHoldWeapon] = 0;
		ResetPlayerWeapons(playerid);
		mysql_tquery(connectionID, "UPDATE users SET holdweapon = %i, playerammo = %i WHERE uID = %i", pData[playerid][pHoldWeapon], pData[playerid][pPlayerAmmo], pData[playerid][pID]);
		Inventory_Set(playerid, "Hammer", 18635, 1);
	}

	if(pData[playerid][pHoldWeapon]) {
		PlaceGun(playerid);
	}

	if(ExBJck[playerid] == 1)
	{
		Inventory_Set(playerid, "Harness", 1275, 1);
    }
   
        if(IsSprayingMoney[playerid])
    {
        KillTimer(MoneySprayTimer[playerid]);
        RemovePlayerAttachedObject(playerid, 5);
    }
    
    EndCall(playerid);
    
	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
    if(pData[playerid][pKicked]) return 0;
    if(IsPlayerNPC(playerid)) return 1;

	if(!pData[playerid][pLogged])
	{
	    ClearChat(playerid);
    	for(new i = 0; i < 5; i ++)
		{
		    SCM(playerid, -1, " ");
		}

		TogglePlayerSpectating(playerid, 1);
		SetPlayerColor(playerid, 0xFFFFFF00);

		PlayAudioStreamForPlayer(playerid, "https://l.top4top.io/m_3672u8j080.mp3");

		// Due to a SA-MP bug, you can't apply camera coordinates directly after enabling spectator mode (to hide HUD).
		// In this case we'll use a timer to defer this action.
  		SetTimerEx("ShowMainMenuCamera", 400, false, "i", playerid);
	}

	return 1;
}

