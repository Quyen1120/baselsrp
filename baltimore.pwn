// Variables //
main(){}

ShowHMenu(playerid)
{
    for(new i = 0; i < 19; i++)
    {
        TextDrawShowForPlayer(playerid, HMenuTD[i]);
    }

    SelectTextDraw(playerid, 0xA3B4C5FF);
    return 1;
}

HideHMenu(playerid)
{
    for(new i = 0; i < 19; i++)
    {
        TextDrawHideForPlayer(playerid, HMenuTD[i]);
    }

    CancelSelectTextDraw(playerid);
    return 1;
}

ShowHomePhone(playerid)
{
    for(new i = 0; i < sizeof(phone::HomeUI); i++)
    {
        TextDrawShowForPlayer(playerid, phone::HomeUI[i]);
    }

    PlayerTextDrawShow(playerid, phone::statuscuaca[playerid]);
    PlayerTextDrawShow(playerid, phone::songname[playerid]);
    PlayerTextDrawShow(playerid, phone::songartist[playerid]);
    PlayerTextDrawShow(playerid, phone::cuaca[playerid]);
    PlayerTextDrawShow(playerid, phone::derajat[playerid]);

    SelectTextDraw(playerid, 0xFFFFFFFF);
    return 1;
}

HideHomePhone(playerid)
{
    for(new i = 0; i < sizeof(phone::HomeUI); i++)
    {
        TextDrawHideForPlayer(playerid, phone::HomeUI[i]);
    }

    PlayerTextDrawHide(playerid, phone::statuscuaca[playerid]);
    PlayerTextDrawHide(playerid, phone::songname[playerid]);
    PlayerTextDrawHide(playerid, phone::songartist[playerid]);
    PlayerTextDrawHide(playerid, phone::cuaca[playerid]);
    PlayerTextDrawHide(playerid, phone::derajat[playerid]);

    CancelSelectTextDraw(playerid);
    return 1;
}

new TravelVehicle[MAX_PLAYERS];

#define APARTMENT_INT 3
#define APARTMENT_WORLD 1


