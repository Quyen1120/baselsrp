	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2195.1714,-2297.4751,14.1717,44.9319,1,1,360); // 10
	CreateTruckBody(tmpveh);
	tmpveh = CreateVehicle(578,2191.6055,-2301.3247,14.1722,45.4955,1,1,360); // 11
