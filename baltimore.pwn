			return 1;
		new rem=af_hprem[playerid];
		RemoveCarFromTruckBody(playerid);
		af_player_lootstatus[playerid] = false;
		af_player_status[playerid] = false;
		new amount;
		switch(af_carList[playerid]) {
			case 0: amount = 1877;
			case 1: amount = 1999;
			case 2: amount = 1567;
			case 3: amount = 1855;
			case 4: amount = 1977;
			case 5: amount = 1776;
			case 6: amount = 1872;
			case 7: amount = 1653;
			case 8: amount = 1684;
			case 9: amount = 1477;
			case 10: amount = 1875;
			case 11: amount = 1778;
			case 12: amount = 1871;
			case 13: amount = 2234;
			case 14: amount = 1871;
			case 15: amount = 2500;
