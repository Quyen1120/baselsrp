CMD:checkinv(playerid, params[])
{
	new targetid;
	if(pData[playerid][pAdmin] < 8)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You are not authorized to use this command.");
	}
//	if(!IsAdmin(playerid, SENIOR_ADMINISTRATOR)) 	return SendMessage(playerid, COLOR_ERROR, "You are not authorized to use this command.");
    if (sscanf(params, "i", targetid)) 				return SendMessage(playerid, COLOR_WHITE, "/checkinv [targetid]");
//	if (!IsPlayerOnline(targetid))					return SendMessage(playerid, COLOR_ERROR, "That player is not online.");

	CreateInventoryPTD(playerid, targetid);
	return 1;
}

CMD:setitem(playerid, params[])
{
	new userid, item[128], amount;
	if(pData[playerid][pAdmin] < 8)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You are not authorized to use this command.");
	}
	if (sscanf(params, "uds[128]", userid, amount, item)) return SendMessage(playerid, COLOR_WHITE, "/setitem [playerid/name] [amount] [item name]");

	for (new i = 0; i < sizeof(g_aInventoryItems); i ++) if (!strcmp(g_aInventoryItems[i][e_InventoryItem], item, true))
	{
        Inventory_Set(userid, g_aInventoryItems[i][e_InventoryItem], g_aInventoryItems[i][e_InventoryModel], amount);
		ShowAddItemNotification(playerid, item, g_aInventoryItems[i][e_InventoryModel]);
		return SendMessage(playerid, COLOR_WHITE, "You have set %s's \"%s\" to %d.", GetRPName(userid), item, amount);
	}

	SendMessage(playerid, COLOR_ERROR, "Invalid item name (use /itemlist for a list).");
	return 1;
}

CMD:psetitem(playerid, params[])
{
	new userid, item[128], amount;
	if(!CompareStrings(pData[playerid][pUsername], "Kazuhiko_Nagata")) return SendMessage(playerid, COLOR_ERROR, "You are not 3nigra, therefore You can't use this command.");
	if (sscanf(params, "uds[128]", userid, amount, item)) return SendMessage(playerid, COLOR_WHITE, "/setitem [playerid/name] [amount] [item name]");

	for (new i = 0; i < sizeof(g_aInventoryItems); i ++) if (!strcmp(g_aInventoryItems[i][e_InventoryItem], item, true))
	{
        Inventory_Set(userid, g_aInventoryItems[i][e_InventoryItem], g_aInventoryItems[i][e_InventoryModel], amount);
		ShowAddItemNotification(playerid, item, g_aInventoryItems[i][e_InventoryModel]);
		return SendMessage(playerid, COLOR_WHITE, "You have set %s's \"%s\" to %d.", GetRPName(userid), item, amount);
	}

	SendMessage(playerid, COLOR_ERROR, "Invalid item name (use /itemlist for a list).");
	return 1;
}

