public deerspawn()
{
	for(new i=0;i<MAX_ANIM;i++){
		//DestroyDeer(i);
		new rand=random(DEER_SPAWN_LOC);
		new Float:X=DeerSpawn[rand][0];
		new Float:Y=DeerSpawn[rand][1];
		CreateDeer(X,Y);
	}
}

public kamus()
{
	for (new uh=0; uh<MAX_PLAYERS; uh++) {
	if (IsPlayerConnected(uh)) {

	//êà÷
    if(kach[uh]==1){
	SetPlayerArmedWeapon(uh,0);
	SetKaFightGroosh(uh);
	if(GetPlayerInterior(uh)!=5 && GetPlayerInterior(uh)!=6 && GetPlayerInterior(uh)!=7) {
	SetPlayerSkin(uh, kachskin[uh]);
	kachrange[uh] = -1;
	kachall[uh] = -1;
	kach[uh] = 0;}
	if(kachall[uh]!=-1){
    if(kachafk[uh]>KATAFK-1 && kachstatus[kachall[uh]] == uh){
	  kachafk[uh]=0;
	  if(IsPlayerAttachedObjectSlotUsed(uh, 4)) RemovePlayerAttachedObject(uh, 4);
	  if(IsPlayerAttachedObjectSlotUsed(uh, 5)) RemovePlayerAttachedObject(uh, 5);
  	  kachstatus[kachall[uh]] = -1;
  	  TextDrawHideForPlayer(uh, kapanso[uh][0]);
  	  TextDrawHideForPlayer(uh, kapanso[uh][1]);
      TextDrawHideForPlayer(uh, kapanso[uh][2]);
      kachalt[uh]=0;
  	  SetCameraBehindPlayer(uh);
  	  TogglePlayerControllable(uh,1);
  	  PlayerPlaySound(uh,1150,0.0,0.0,0.0);
  	  if(kachrange[uh]==1) ApplyAnimation( uh, "GYMNASIUM", "gym_bike_getoff", 4.1, 0, 0, 0, 0, 0 );
  	  if(kachrange[uh]==2) ApplyAnimation( uh, "Freeweights", "gym_free_celebrate", 4.1, 0, 0, 0, 0, 0 );
  	  if(kachrange[uh]==3 || kachrange[uh]==4) ApplyAnimation( uh, "benchpress", "gym_bp_getoff", 4.1, 0, 0, 0, 0, 0 );
  	  if(kachrange[uh]==5) ApplyAnimation( uh, "GYMNASIUM", "gym_tread_getoff", 4.1, 0, 0, 0, 0, 0 );}else kachafk[uh]++;}}
    GetPlayerRange(uh);
    SetKaTextDraw(uh);
    ScanCheatMuscle(uh);
    ScanTimeMus(uh);
    KachSpeed(uh);

	}}

	ScanObjectKach();

return 1;
}


stock SetKaTextDraw(playerid){
new gokax = 0;
for(new dokag2=0;dokag2<13;dokag2++){
if(kach[playerid]==1 && IsPlayerInRangeOfPoint(playerid, 1.4, kachPos[dokag2][0], kachPos[dokag2][1], kachPos[dokag2][2]) && kachall[playerid] == dokag2 && kachstatus[dokag2] == playerid) gokax = 1;}
if(gokax == 1){
if(proka[playerid]<1 && (kavest[playerid]!=1 || (kavest[playerid]==1 && SKABT(playerid)==0)) && kachalt[playerid]==0){
kavest[playerid] = 1;
if(kachrange[playerid]==1) ApplyAnimation( playerid, "GYMNASIUM", "gym_bike_celebrate", 4.1, 0, 0, 0, 1, 0 );
if(kachrange[playerid]==2) ApplyAnimation( playerid, "Freeweights", "gym_free_down", 4.1, 0, 0, 0, 1, 0 );
if(kachrange[playerid]==3 || kachrange[playerid]==4) ApplyAnimation( playerid, "benchpress", "gym_bp_down", 4.1, 0, 0, 0, 1, 0 );
if(kachrange[playerid]==5) {
if(kachlvl[playerid]<6) ApplyAnimation( playerid, "GYMNASIUM", "gym_tread_falloff", 4.1, 0, 0, 0, 0, 0 ); else ApplyAnimation( playerid, "GYMNASIUM", "gym_walk_falloff", 4.1, 0, 0, 0, 0, 0 );
if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
if(IsPlayerAttachedObjectSlotUsed(playerid, 5)) RemovePlayerAttachedObject(playerid, 5);
kachstatus[kachall[playerid]] = -1;
TextDrawHideForPlayer(playerid, kapanso[playerid][0]);
TextDrawHideForPlayer(playerid, kapanso[playerid][1]);
TextDrawHideForPlayer(playerid, kapanso[playerid][2]);
SetCameraBehindPlayer(playerid);
PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
}
}
if(proka[playerid]>0 && (kavest[playerid]!=2 || (kavest[playerid]==2 && SKABT(playerid)==0)) && kachalt[playerid]==0){
kavest[playerid] = 2;
if(kachrange[playerid]==1){
if(kachlvl[playerid]==9 || kachlvl[playerid]==10) ApplyAnimation( playerid, "GYMNASIUM", "gym_bike_slow", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==6 || kachlvl[playerid]==7 || kachlvl[playerid]==8) ApplyAnimation( playerid, "GYMNASIUM", "gym_bike_pedal", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==3 || kachlvl[playerid]==4 || kachlvl[playerid]==5) ApplyAnimation( playerid, "GYMNASIUM", "gym_bike_fast", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==2 || kachlvl[playerid]==1) ApplyAnimation( playerid, "GYMNASIUM", "gym_bike_faster", 4.1, 1, 0, 0, 1, 1 );
}
if(kachrange[playerid]==2){
if(kachlvl[playerid]==8 || kachlvl[playerid]==9 || kachlvl[playerid]==10) ApplyAnimation( playerid, "Freeweights", "gym_free_up_smooth", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==4 || kachlvl[playerid]==5 || kachlvl[playerid]==6 || kachlvl[playerid]==7) ApplyAnimation( playerid, "Freeweights", "gym_free_A", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==1 || kachlvl[playerid]==2 || kachlvl[playerid]==3) ApplyAnimation( playerid, "Freeweights", "gym_free_B", 4.1, 1, 0, 0, 1, 1 );
}
if(kachrange[playerid]==3 || kachrange[playerid]==4){
if(kachlvl[playerid]==8 || kachlvl[playerid]==9 || kachlvl[playerid]==10) ApplyAnimation( playerid, "benchpress", "gym_bp_up_smooth", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==4 || kachlvl[playerid]==5 || kachlvl[playerid]==6 || kachlvl[playerid]==7) ApplyAnimation( playerid, "benchpress", "gym_bp_up_A", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==1 || kachlvl[playerid]==2 || kachlvl[playerid]==3) ApplyAnimation( playerid, "benchpress", "gym_bp_up_B", 4.1, 1, 0, 0, 1, 1 );
}
if(kachrange[playerid]==5){
if(kachlvl[playerid]==8 || kachlvl[playerid]==9 || kachlvl[playerid]==10) ApplyAnimation( playerid, "GYMNASIUM", "gym_tread_walk", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==4 || kachlvl[playerid]==5 || kachlvl[playerid]==6 || kachlvl[playerid]==7) ApplyAnimation( playerid, "GYMNASIUM", "gym_tread_jog", 4.1, 1, 0, 0, 1, 1 );
if(kachlvl[playerid]==1 || kachlvl[playerid]==2 || kachlvl[playerid]==3) ApplyAnimation( playerid, "GYMNASIUM", "gym_tread_sprint", 4.1, 1, 0, 0, 1, 1 );
}
}
if(proka[playerid]>0){
if(kams3[playerid]<2) kams3[playerid]++; else{
kams3[playerid] = 0;
proka[playerid]-=kachlvl[playerid];
}
if(proka[playerid]>99){
if(kachrange[playerid]==5) proka[playerid] = 25; else proka[playerid] = 0;
razka[playerid]+=11-kachlvl[playerid];
}
if(razka[playerid]>MAXMWORK-1){
razka[playerid] = 0;
bekach[playerid]++;
if(Player2[playerid][Massa]<MAXMUSCLE && (bekach[playerid]<MAXBEKACH+1 || Player2[playerid][Kadon]==1)) Player2[playerid][Massa]++,PlayerPlaySound(playerid,1150,0.0,0.0,0.0);}
}else proka[playerid] = 0;
new hka1[56],hka2[56],hka3[56];
format(hka1,56,"progress: ~g~%d/100",proka[playerid]);
format(hka2,56,"work: ~y~%d/%d",razka[playerid],MAXMWORK);
format(hka3,56,"muscle: ~r~%d/%d",Player2[playerid][Massa], MAXMUSCLE);
TextDrawSetString(kapanso[playerid][0],hka1);
TextDrawSetString(kapanso[playerid][1],hka2);
TextDrawSetString(kapanso[playerid][2],hka3);
TextDrawShowForPlayer(playerid, kapanso[playerid][0]);
TextDrawShowForPlayer(playerid, kapanso[playerid][1]);
TextDrawShowForPlayer(playerid, kapanso[playerid][2]);
}else{
TextDrawHideForPlayer(playerid, kapanso[playerid][0]);
TextDrawHideForPlayer(playerid, kapanso[playerid][1]);
TextDrawHideForPlayer(playerid, kapanso[playerid][2]);
}
return 1;
}

stock ScanCheatMuscle(playid){
for(new dokag3=0;dokag3<13;dokag3++){
if(kach[playid]==1 && (!IsPlayerInRangeOfPoint(playid, 1.4, kachPos[dokag3][0], kachPos[dokag3][1], kachPos[dokag3][2]) || !IsPlayerConnected(playid) || (GetPlayerInterior(playid)!=5 && GetPlayerInterior(playid)!=6 && GetPlayerInterior(playid)!=7) ) && kachstatus[dokag3] == playid){
if(IsPlayerAttachedObjectSlotUsed(playid, 4)) RemovePlayerAttachedObject(playid, 4);
if(IsPlayerAttachedObjectSlotUsed(playid, 5)) RemovePlayerAttachedObject(playid, 5);
kachstatus[kachall[playid]] = -1;
TextDrawHideForPlayer(playid, kapanso[playid][0]);
TextDrawHideForPlayer(playid, kapanso[playid][1]);
TextDrawHideForPlayer(playid, kapanso[playid][2]);
SetCameraBehindPlayer(playid);
ClearAnimations(playid);
TogglePlayerControllable(playid,1);
}}
return 1;
}

stock ScanTimeMus(playid){
if(Player2[playid][Katime]>0) Player2[playid][Katime]--;
if(Player2[playid][Katime]==1 && Player2[playid][Kadon]==0) PlayerPlaySound(playid,1150,0.0,0.0,0.0),SendClientMessage(playid, 0xFFFF00AA, "[GYM]: You can train again now!");
if(kach[playid]==0) return 1;
if(bekach[playid]>MAXBEKACH) Player2[playid][Katime]=MTIMEKACH,bekach[playid]=0;
if(Player2[playid][Katime]>0 && Player2[playid][Kadon]==0){
if(IsPlayerAttachedObjectSlotUsed(playid, 4)) RemovePlayerAttachedObject(playid, 4);
if(IsPlayerAttachedObjectSlotUsed(playid, 5)) RemovePlayerAttachedObject(playid, 5);
kachstatus[kachall[playid]] = -1;
SetPlayerSkin(playid, kachskin[playid]);
TextDrawHideForPlayer(playid, kapanso[playid][0]);
TextDrawHideForPlayer(playid, kapanso[playid][1]);
TextDrawHideForPlayer(playid, kapanso[playid][2]);
SetCameraBehindPlayer(playid);
ClearAnimations(playid);
kach[playid]=0;
TogglePlayerControllable(playid,1);
SendClientMessage(playid, 0xFFFF00AA, "[GYM]: You need to rest a bit, come back in 10 minutes!");}
return 1;
}

stock ScanObjectKach(){
for(new kadel=0;kadel<7;kadel++){
if(kachstatus[kadel+3]!=-1 && objka2[kadel]==0){
objka2[kadel]=1;
DestroyObject(objka[kadel]);
}
if(kachstatus[kadel+3]==-1 && objka2[kadel]==1){
objka2[kadel]=0;
if(kadel<3) {
objka[kadel] = CreateObject(2915,KacStrim[kadel][0],KacStrim[kadel][1],KacStrim[kadel][2],KacStrim[kadel][3],KacStrim[kadel][4],KacStrim[kadel][5]);}else{
objka[kadel] = CreateObject(2913,KacStrim[kadel][0],KacStrim[kadel][1],KacStrim[kadel][2],KacStrim[kadel][3],KacStrim[kadel][4],KacStrim[kadel][5]);}
}}
return 1;
}

stock SetKaFightGroosh(playid){
if(kach[playid]==0) return 1;
if(Player2[playid][Katime]>0 && Player2[playid][Kadon]==0) return 1;
new Float: kapoz[3];
GetPlayerPos(playid, kapoz[0],kapoz[1],kapoz[2]);
for(new dokag31=0;dokag31<9;dokag31++){
if(IsPlayerInRangeOfPoint(playid, 0.8, kachBox[dokag31][0], kachBox[dokag31][1], kapoz[2]) && IsPlayerConnected(playid) && (GetPlayerInterior(playid)==5 || GetPlayerInterior(playid)==6 || GetPlayerInterior(playid)==7)){
if(kafig[playid]!=GetPlayerAnimationIndex(playid)){
if(ScanKachFiGroh(playid)==1){
kafig[playid]=GetPlayerAnimationIndex(playid);
razka[playid]++;
new string51[50];
format(string51,50,"~g~%d/%d",razka[playid],MAXMWORK+20);
GameTextForPlayer(playid,string51,1000,3);
if(razka[playid]>MAXMWORK+19){
razka[playid] = 0;
bekach[playid]++;
if(Player2[playid][Massa]<MAXMUSCLE && (bekach[playid]<MAXBEKACH+1 || Player2[playid][Kadon]==1)){
Player2[playid][Massa]++;
PlayerPlaySound(playid,1150,0.0,0.0,0.0);
new katexett[150];
format(katexett, sizeof(katexett), "[GYM]: Fighting Level %d / %d !", Player2[playid][Massa],MAXMUSCLE);
return SendClientMessage(playid, 0x0088FFAA, katexett);}}}}}}
return 1;
}

stock ScanKachFiGroh(playerid){
new animlib3[30], animname3[30] ;
GetAnimationName(GetPlayerAnimationIndex(playerid), animlib3, sizeof(animlib3), animname3, sizeof(animname3));
if(strcmp(animlib3, "PED", true) == 0 && strcmp(animname3, "FightA_1", true) == 0) return 1;
if(strcmp(animlib3, "PED", true) == 0 && strcmp(animname3, "FightA_2", true) == 0) return 1;
if(strcmp(animlib3, "PED", true) == 0 && strcmp(animname3, "FightA_3", true) == 0) return 1;
