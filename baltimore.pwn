	VehicleInfo[vehicleid][vEngineOil] = 1000.0;
	VehicleInfo[vehicleid][vNitrous] = 0;
	VehicleInfo[vehicleid][vRaceMod] = 0;

	// inventory remove

	for(new i = 0; i < 14; i ++)
	{
	    VehicleInfo[vehicleid][vMods][i] = 0;
	}
	ResetVehicleObjects(vehicleid);
}

forward RaceMod(vehicleid, playerid);
public RaceMod(vehicleid, playerid)
{
    if(VehicleInfo[vehicleid][vRaceMod] == 0)
	{
	    
	    VehicleInfo[vehicleid][vRaceMod] = 1;
        
    	SendProximityMessage(playerid, 10.0, COLOR_PLUM, "**{C2A2DA} %s Turned on Race Mod.", GetRPName(playerid));
		
    	SendMessage(playerid, COLOR_TEAL, "Race Mod Is {C2A2DA}ACTIVATED!");
	}
	else
	{
	    VehicleInfo[vehicleid][vRaceMod] = 0;
	    SendMessage(playerid, COLOR_TEAL, "Race Mod Is deactivated!");

		SendProximityMessage(playerid, 10.0, COLOR_PLUM, "**{C2A2DA} %s Turned off Race Mod", GetRPName(playerid));
	}
	return 1;
}

GangZoneCreateEx(Float:minx, Float:miny, Float:maxx, Float:maxy)
{
	return GangZoneCreate((minx > maxx) ? (maxx) : (minx), (miny > maxy) ? (maxy) : (miny), (minx > maxx) ? (minx) : (maxx), (miny > maxy) ? (miny) : (maxy));
}

Gate_Nearest(playerid)
{
    for (new i = 0; i != MAX_GATES; i ++) if (GateData[i][gateExists] && IsPlayerInRangeOfPoint(playerid, GateData[i][gateRadius], GateData[i][gatePos][0], GateData[i][gatePos][1], GateData[i][gatePos][2]))
	{
		if (GetPlayerInterior(playerid) == GateData[i][gateInterior] && GetPlayerVirtualWorld(playerid) == GateData[i][gateWorld])
			return i;
	}
	return -1;
}
Object_Nearest(playerid)
{
    for (new i = 0; i != MAX_MAPOBJECTS; i ++) if (ObjectData[i][mobjExists] && IsPlayerInRangeOfPoint(playerid, 3.0, ObjectData[i][mobjPos][0], ObjectData[i][mobjPos][1], ObjectData[i][mobjPos][2]))
	{
		if (GetPlayerInterior(playerid) == ObjectData[i][mobjInterior] && GetPlayerVirtualWorld(playerid) == ObjectData[i][mobjWorld])
			return i;
	}
	return -1;
}

forward TurboUp();
public TurboUp()
{
    new vehicleid, keys, Float:vx, Float:vy, Float:vz, Float:speed;

    for (new playerid = 0; playerid < GetMaxPlayers(); playerid++)
    {
        if (!IsPlayerConnected(playerid)) continue;

        if ((vehicleid = GetPlayerVehicleID(playerid)))
        {
            GetPlayerKeys(playerid, keys, _:vx, _:vx);
            speed = GetVehicleSpeedMPH(vehicleid);

            if ((keys & (KEY_VEHICLE_FORWARD | KEY_VEHICLE_BACKWARD | KEY_HANDBRAKE)) == KEY_VEHICLE_FORWARD && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
            {
                GetVehicleVelocity(vehicleid, vx, vy, vz);

                // Calculate max speed based on installed upgrades
                new Float:upgradeBoost = 0.0;
                upgradeBoost += VehicleInfo[vehicleid][vEngineUpgrade] * 2.6;
                upgradeBoost += VehicleInfo[vehicleid][vFuelSystem] * 3.0; //
                upgradeBoost += VehicleInfo[vehicleid][vCamshaft] * 2.6;
                upgradeBoost += VehicleInfo[vehicleid][vEcu] * 2.6;
                upgradeBoost += VehicleInfo[vehicleid][vIntake] * 2.6;
                upgradeBoost += VehicleInfo[vehicleid][vExhaust] * 2.6;
                upgradeBoost += VehicleInfo[vehicleid][vTurbo] * 3.0; // 
                upgradeBoost += VehicleInfo[vehicleid][vIgnition] * 2.6;
                upgradeBoost += VehicleInfo[vehicleid][vTransmission] * 3.0; //
                upgradeBoost += VehicleInfo[vehicleid][vDrivetrain] * 3.0;//
                upgradeBoost += VehicleInfo[vehicleid][vNitrous] * 3.5;//

                new Float:maxSpeed = 100 + upgradeBoost;

                // **Force oil limit always, regardless of vRaceMod**
                if (VehicleInfo[vehicleid][vEngineOil] < 100.0)  
                {
                    maxSpeed = 35.0; // **Limit speed due to low oil**
                }

                // **Only apply modifications if RaceMod is ON**
                if (VehicleInfo[vehicleid][vRaceMod] > 0)
                {
                    if (maxSpeed > MAX_SPEED) maxSpeed = MAX_SPEED;

                    if (speed > maxSpeed)
                    {
                        vx = vx * (maxSpeed / speed);
                        vy = vy * (maxSpeed / speed);
                        SetVehicleVelocity(vehicleid, vx, vy, vz);
                    }
                    else
                    {
                        if (vx * vx + vy * vy < g_TurboThreshold)
                            continue;

                        new Float:Boost = 1.0 + ((upgradeBoost / 100.0) / 30);

                        vx *= Boost;
                        vy *= Boost;

                        if (vz > 0.04 || vz < -0.04)
                            vz -= 0.020;

                        SetVehicleVelocity(vehicleid, vx, vy, vz);
                    }
                }
                else if (VehicleInfo[vehicleid][vEngineOil] < 100.0)
                {
                    // **If race mod is OFF, only apply oil speed limit**
                    if (speed > maxSpeed)
                    {
                        vx = vx * (maxSpeed / speed);
                        vy = vy * (maxSpeed / speed);
                        SetVehicleVelocity(vehicleid, vx, vy, vz);
                    }
                }
            }
        }
    }
}

forward IsCopCar(vehicleid);
public IsCopCar(vehicleid)
{
    
    new copCarModels[] = { 596, 597, 598, 599, 600, 601, 407, 416, 427, 490, 523, 528,   }; 

    for (new i = 0; i < sizeof(copCarModels); i++)
    {
        if (GetVehicleModel(vehicleid) == copCarModels[i])
        {
            return 1; 
        }
    }
    return 0; 
}




