	ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0);
	SendProximityMessage(playerid, 10.0, COLOR_PLUM, "** %s  rolls up his toilet paper with some dope ahh shiit.", GetRPName(playerid));

    return 1;
}

