		    {
		        switch(listitem)
		        {
		            case 0: pData[playerid][pSelected] = ITEM_HPAMMO;
		            case 1: pData[playerid][pSelected] = ITEM_POISONAMMO;
		            case 2: pData[playerid][pSelected] = ITEM_FMJAMMO;
		        }

				ShowDialogToPlayer(playerid, DIALOG_GANGSTASHAMMO2);
