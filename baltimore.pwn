RGBAToARGB(rgba)
    return rgba >>> 8 | rgba << 24;

forward RegenerateStone();
public RegenerateStone()
{
    for(new i = 1; i < sizeof OreInfo; i++) if(OreInfo[i][oExist] == true)
    {
        OreInfo[i][oMinutes] ++;

        if(OreInfo[i][oType] == ORE_COPPER && OreInfo[i][oMinutes] == 10) {
            OreInfo[i][oCount] = 35; 
            OreInfo[i][oMinutes] = 0;
            UpdateOreName(OreInfo[i][oType], i);
        }
        if(OreInfo[i][oType] == ORE_AMETHYST && OreInfo[i][oMinutes] == 15) {
            OreInfo[i][oCount] = 35; 
            OreInfo[i][oMinutes] = 0;
            UpdateOreName(OreInfo[i][oType], i);
        }
        if(OreInfo[i][oType] == ORE_EMERALD && OreInfo[i][oMinutes] == 20) {
            OreInfo[i][oCount] = 35; 
            OreInfo[i][oMinutes] = 0;
            UpdateOreName(OreInfo[i][oType], i);
        }
        if(OreInfo[i][oType] == ORE_RUBY && OreInfo[i][oMinutes] == 25) {
            OreInfo[i][oCount] = 35; 
            OreInfo[i][oMinutes] = 0;
            UpdateOreName(OreInfo[i][oType], i);
        }
        if(OreInfo[i][oType] == ORE_SAPPHIRE && OreInfo[i][oMinutes] == 30) {
            OreInfo[i][oCount] = 35; 
            OreInfo[i][oMinutes] = 0;
            UpdateOreName(OreInfo[i][oType], i);
        }
        if(OreInfo[i][oType] == ORE_GOLD && OreInfo[i][oMinutes] == 35) {
            OreInfo[i][oCount] = 35; 
            OreInfo[i][oMinutes] = 0;
            UpdateOreName(OreInfo[i][oType], i);
        }
    }
    
}
