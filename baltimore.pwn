			SetPVarInt(playerid, "iCurrentWeapon", iCurWeap);
		}
    }
	if(playerWheelchair[playerid] == 1)
    {
		//TogglePlayerControllable(playerid, true);
		
 
        new Float:a;
        new Keys,ud,lr;
        GetPlayerKeys(playerid,Keys,ud,lr);
