if(strcmp(animlib3, "FIGHT_B", true) == 0 && strcmp(animname3, "FightB_1", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_B", true) == 0 && strcmp(animname3, "FightB_2", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_B", true) == 0 && strcmp(animname3, "FightB_3", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_B", true) == 0 && strcmp(animname3, "FightB_M", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_C", true) == 0 && strcmp(animname3, "FightC_1", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_C", true) == 0 && strcmp(animname3, "FightC_2", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_C", true) == 0 && strcmp(animname3, "FightC_3", true) == 0) return 1;
if(strcmp(animlib3, "FIGHT_C", true) == 0 && strcmp(animname3, "FightC_M", true) == 0) return 1;
if(strcmp(animlib3, "PED", true) == 0 && strcmp(animname3, "GUN_BUTT", true) == 0) return 1;
