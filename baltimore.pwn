IsAmmoCompatibleWithWeapon(weaponid, const ammo[])
{
    for (new i = 0; i < sizeof(weaponAmmo); i++)
    {
        if (weaponAmmo[i][0] == weaponid && !strcmp(weaponAmmo[i][1], ammo))
        {
            return true;
        }
    }
    return false;
}

UseAmmo(playerid, const ammo[], itemid)
{
    if (pData[playerid][pHoldWeapon])
    {
        if (IsAmmoCompatibleWithWeapon(pData[playerid][pHoldWeapon], ammo))
        {
            if (Inventory_HasItem(playerid, ammo) && pData[playerid][pPlayerAmmo] > 0)
            {
                pData[playerid][pPlayerAmmo] = InventoryData[playerid][itemid][invQuantity];
                SetPlayerAmmo(playerid, pData[playerid][pHoldWeapon], InventoryData[playerid][itemid][invQuantity]);
                Inventory_RemoveEx(playerid, itemid, -1);
                HidePlayerInventory(playerid);
            }
			if(IsPlayerAttachedObjectSlotUsed(playerid, 9) && pData[playerid][pPlayerAmmo] <= 0)
			{
				RemovePlayerAttachedObject(playerid, 9);
				GivePlayerWeaponExx(playerid, pData[playerid][pHoldWeapon], InventoryData[playerid][itemid][invQuantity]);
				pData[playerid][pHoldWeapon] = pData[playerid][pHoldWeapon];
				mysql_tquery(connectionID, "UPDATE users SET holdweapon = %i WHERE uid = %i", pData[playerid][pHoldWeapon], pData[playerid][pID]);
				HidePlayerInventory(playerid);
				Inventory_RemoveEx(playerid, itemid, -1);
			}
			ApplyAnimationEx(playerid, "BUDDY", "buddy_reload", 4.1, 0, 0, 0, 0, 0);
        }
        else
        {
            SCM(playerid, COLOR_WHITE, "This ammo is not compatible with your current weapon.");
        }
    }
    else
    {
        SCM(playerid, COLOR_WHITE, "You must be holding a compatible weapon to use ammo.");
    }
    return 1;
}

stock SetPlayerWeaponss(playerid)
{
	if (pData[playerid][pHoldWeapon] != 0)
	{
		if (pData[playerid][pPlayerAmmo] != 0)
			GivePlayerWeaponExx(playerid, pData[playerid][pHoldWeapon], pData[playerid][pPlayerAmmo]);
		else 
			SetPlayerAttachedObject(playerid, 9, Weapon_GetModelID(pData[playerid][pHoldWeapon]), 6, 0.0, 0.0, 0.0);
	}

	//LoadHolsters(playerid);
	return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	if (hittype == BULLET_HIT_TYPE_PLAYER)
    {
        if ((floatcmp(floatabs(fX), 20.0) == 1) || (floatcmp(floatabs(fY), 20.0) == 1) || (floatcmp(floatabs(fZ), 20.0) == 1))
		{
			Kick(playerid);
		}
    }

	new raw_slot = Weapon_GetSlot(weaponid), weapons[2];
	GetPlayerWeaponData(playerid, WEAPON_SLOT:raw_slot, WEAPON:weapons[0], weapons[1]);

	pData[playerid][pPlayerAmmo] --;

	if(pData[playerid][pPlayerAmmo] > GetPlayerAmmo(playerid)) {
		pData[playerid][pPlayerAmmo] = weapons[1] - 1;
	}
	if(pData[playerid][pPlayerAmmo] <= 1) 
	{
		for (new i = 0; i < sizeof(weaponAmmo); i++)
		{
			if (weaponid == WEAPON:weaponAmmo[i][0] && Inventory_HasItem(playerid, weaponAmmo[i][1]))
			{
				new itemid = Inventory_GetItemIDEx(playerid, weaponAmmo[i][1]);
				pData[playerid][pPlayerAmmo] = InventoryData[playerid][itemid][invQuantity];
			//	SetPlayerAmmo(playerid, weaponAmmo[i][0], InventoryData[playerid][itemid][invQuantity]);
				//Inventory_RemoveEx(playerid, itemid, -1);
				break;
			}
			else{
				pData[playerid][pPlayerAmmo] = 0;
				mysql_tquery(connectionID, "UPDATE users SET playerammo = %i WHERE uid = %i", pData[playerid][pPlayerAmmo], pData[playerid][pID]);
			}
		}
	}

	if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID)
	{
		if((1 <= EventInfo[eType] <= 2) && pData[playerid][pJoinedEvent])
		{
		    if(!EventInfo[eStarted])
		    {
		     	GameTextForPlayer(playerid, "~r~Don't shoot until the event starts!", 2000, 3);
			    return 0;
			}
			else if(EventInfo[eType] == 2 && pData[hitid][pEventTeam] == pData[playerid][pEventTeam])
			{
	            GameTextForPlayer(playerid, "~r~Do not teamkill!", 2000, 3);
			    return 0;
			}
		}
		if(pData[playerid][pAcceptedHelp])
		{
		    GameTextForPlayer(playerid, "~r~Don't shoot at newbies!", 2000, 3);
		    return 0;
		}
	}
/*	if (weaponid == 23 && pData[playerid][pTazer] && GetFactionType(playerid) == FACTION_POLICE && GetFactionType(playerid) == FACTION_DOC && GetFactionType(playerid) == FACTION_SHERIFF) {
		ApplyAnimation(playerid, "COLT45", "colt45_reload", 4.1, 0, 0, 0, 0, 0);
		SetTimerEx("OnTaserShoot", 1100, false, "i", playerid);
	    PlayerPlaySound(playerid, 6003, 0.0, 0.0, 0.0);
		SetTimerEx("RechargeTazer", 2000, false, "i", playerid);
		SCM(playerid, COLOR_SYNTAX, "Recharging tazer, please wait...");
	}
	else if (weaponid == 25 && pData[playerid][pBeanbag] && GetFactionType(playerid) == FACTION_POLICE && GetFactionType(playerid) == FACTION_DOC && GetFactionType(playerid) == FACTION_SHERIFF) {
		ApplyAnimation(playerid, "COLT45", "colt45_reload", 4.1, 0, 0, 0, 0, 0);
		SetTimerEx("onBeanBagShoot", 1100, false, "i", playerid);
	    PlayerPlaySound(playerid, 6003, 0.0, 0.0, 0.0);
		SetTimerEx("ReachargeBeanBag", 2000, false, "i", playerid);
		SCM(playerid, COLOR_SYNTAX, "Refilling Bullets, please wait...");
	}
    if(weaponid != 22 && weaponid != 26 && weaponid != 28 && weaponid != 32)
	{
		if(pData[playerid][pClip] > 0)
		{
		    new
				string[12];

		    pData[playerid][pCurrentAmmo] = GetPlayerAmmo(playerid);
		    pData[playerid][pClip]--;

		    format(string, sizeof(string), "%i", pData[playerid][pClip]);
		    PlayerTextDrawSetString(playerid, pData[playerid][pText][5], string);
		}
	}*/

	new string[128];
    format(string, sizeof(string),"%s Shooting with his gun.",GetRPName(playerid));
    //DCC_SendChannelMessage(SF_Channel,string);

	if(!PlayerHasWeapon(playerid, weaponid, true) && pData[playerid][pAdmin] < 2 && !pData[playerid][pKicked] && gettime() > pData[playerid][pACTime])
	{
	    new
	        string[48];

		format(string, sizeof(string), "Weapon hacks (%s)", GetWeaponNameEx(weaponid));

		SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was banned by %s, reason: %s", GetRPName(playerid), SERVER_BOT, string);
		BanPlayer(playerid, SERVER_BOT, string);
		//Kick(playerid);
	    return 0;
	}

	if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID)
	{
	    if(!pData[hitid][pJoinedEvent] && pData[hitid][pDueling] == INVALID_PLAYER_ID)
		{
	    	GetPlayerArmour(hitid, pData[hitid][pArmor]);
		}
	}
	if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID)
	{
	    if(!pData[hitid][pJoinedEvent] && !pData[hitid][pPaintball] && pData[hitid][pDueling] == INVALID_PLAYER_ID && !pData[hitid][pPaintball2])
		{
	    	GetPlayerArmour(hitid, pData[hitid][pArmor]);
		}
	}
    /*if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(22 <= GetPlayerWeapon(playerid) <= 36)
		{
	  		if(pData[playerid][pACAmmo] == GetPlayerAmmo(playerid))
			{
	  			pData[playerid][pACFired]++;
			}

		    if(!pData[playerid][pReloading] && pData[playerid][pACFired] >= 20)
    		{
		        if((gAnticheat) && pData[playerid][pAdmin] < 2 && !pData[playerid][pKicked])
    		    {
					SAM(COLOR_YELLOW, ""RED"AdmWarning: %s"WHITE" was automatically kicked for infinite ammo.", GetRPName(playerid));
					Log_Write("log_cheat", "%s (uid: %i) was automatically kicked for infinite ammo.", GetPlayerNameEx(playerid), pData[playerid][pID]);
					KickPlayer(playerid);
				}
			}

			pData[playerid][pACAmmo] = GetPlayerAmmo(playerid);
		}
	}*/
	return 1;
}
public OnPlayerModelSelectionEx(playerid, response, extraid, modelid)
{
	if(extraid == MODEL_SELECTION_NEWBIE)
	{
		if(response) {
			SCM(playerid, COLOR_YELLOW, "You have set your own clothes.");
			SetScriptSkin(playerid, modelid);
			switch(random(5))
			{
				case 0:
				{
					SetPlayerPos(playerid, 1955.458251, -1665.001342, 13.535625);
					SetPlayerFacingAngle(playerid, 359.44);
					ApplyAnimationEx(playerid, "GANGS", "leanIDLE", 4.0, 0, 0, 0, 1, 0);
				}
				case 1:
				{
