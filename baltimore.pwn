GetNearbyOre(playerid)
{
    for (new i = 0; i != MAX_ORES; i ++) if (OreInfo[i][oExist] && IsPlayerInRangeOfPoint(playerid, 1.5, OreInfo[i][oPosX], OreInfo[i][oPosY], OreInfo[i][oPosZ]))
	{
	    return i;
	}
	return -1;
}

GetOreTypeColor(type)
{
    switch(type)
    {
        case 0: return 0xB87333FF; 
        case 1: return 0x9B59B6FF; 
        case 2: return 0x2ECC71FF; 
        case 3: return 0xD10056FF; 
        case 4: return 0x0F52BAFF; 
        case 5: return 0xFFD700FF; 
    }
    return 1;
}


GetOreName(type)
{
    new string[128];
    switch(type)
    {
        case 0: string = "Copper Rock"; 
        case 1: string = "Amethyst Rock"; 
        case 2: string = "Emerald Rock"; 
        case 3: string = "Ruby Rock"; 
        case 4: string = "Sapphire Rock";  
        case 5: string = "Gold Rock";  
    }
    return string;
}

UpdateOreName(type, id)
{
    new string[128];
    switch(type)
    {
        case 0: string = "Copper Rock"; 
        case 1: string = "Amethyst Rock"; 
        case 2: string = "Emerald Rock"; 
        case 3: string = "Ruby Rock"; 
        case 4: string = "Sapphire Rock";  
        case 5: string = "Gold Rock";  
    }
    format(string, sizeof(string), "%s\nOre Count: %i/35", string, OreInfo[id][oCount]);
    return string;
}

GetOreIngot(type)
{
    new string[128];
    switch(type)
    {
        case 0: string = "Copper Ingot"; 
        case 1: string = "Amethyst Ingot"; 
        case 2: string = "Emerald Ingot"; 
        case 3: string = "Ruby Ingot"; 
        case 4: string = "Sapphire Ingot";  
        case 5: string = "Gold Ingot";  
    }
    return string;
}

GetOreMinRock(type)
{
    new amount;
    switch(type)
    {
        case 0: amount = 10; 
        case 1: amount = 15; 
        case 2: amount = 20; 
        case 3: amount = 25; 
        case 4: amount = 30;  
        case 5: amount = 35;  
    }
    return amount;
}

