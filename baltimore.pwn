		CarToysInfo[carid][i][CarToys_SQLID] = 0;
	}
}*/

DestroyCarToy(objid)
{
	new carid, obj = findCarToyByObjID(objid,carid);
	if(obj == -1) return 0;
	CarToysInfo[carid][obj][CarToys_ObjID] = 0;

	if(CarToysInfo[carid][obj][CarToys_SQLID] > 0)
    {
    	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "DELETE FROM playercartoys WHERE id = %i", CarToysInfo[carid][obj][CarToys_SQLID]);
        mysql_tquery(connectionID, queryBuffer);
	}
	CarToysInfo[carid][obj][CarToys_SQLID] = 0;
	DestroyDynamicObject(objid);
	return 1;
}

SetCarObjectPos(carid, cartoy, objectid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	CarToysInfo[carid][cartoy][CarToysX] = x;
	CarToysInfo[carid][cartoy][CarToysY] = y;
	CarToysInfo[carid][cartoy][CarToysZ] = z;
	CarToysInfo[carid][cartoy][CarToysRX] = rx;
	CarToysInfo[carid][cartoy][CarToysRY] = ry;
	CarToysInfo[carid][cartoy][CarToysRZ] = rz;
	AttachDynamicObjectToVehicle(objectid, carid, x, y, z, rx, ry, rz);
}

GetWeaponClipSize(weaponid) //Cartridge size
{
    switch(weaponid)
    {
        case 22, 23: return 17;
        case 25, 26, 27: return 30;
        case 24: return 14;
		case 28, 29: return 30;
        case 33, 34: return 10;
        case 30, 31: return 30;
        case 32: return 50;
     //   case 31: return 30;
		default: return 1;
    }
    return 0;
}

GetWeaponClipSizeExt(weaponid) //Cartridge size
{
    switch(weaponid)
    {
        case 22, 23: return 35;
        case 25, 26, 27: return 60;
        case 24: return 28;
		case 28, 29: return 60;
        case 33, 34: return 40;
        case 30, 31: return 60;
        case 32: return 100;
     //   case 31: return 30;
		default: return 1;
    }
    return 0;
}

GetAmmoType(weaponid)
{
    switch(weaponid)
	{
        case 22..23: return NINEMM_AMMO;
		case 24: return PISTOL_AMMO;
        case 25: return SG_AMMO;
        case 28, 29, 32: return SMG_AMMO;
        case 30, 31: return AR_AMMO;
        case 33, 34: return SR_AMMO;
	}
    return NO_AMMO;
}

