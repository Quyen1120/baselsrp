			case SMG_AMMO: if (Inventory_Count(playerid, "9mm") < GetWeaponClipSize(weaponid)) return SendErrorMessage(playerid, "You don't have enough pistol ammo (30) to load your ammo cartridge.");
			case AR_AMMO: if (Inventory_Count(playerid, "5.56x45mm NATO") < GetWeaponClipSize(weaponid)) return SendErrorMessage(playerid, "You don't have enought AR ammo (30) to load your ammo cartridge.");
			case PISTOL_AMMO: if (Inventory_Count(playerid, ".50 AE") < GetWeaponClipSize(weaponid)) return SendErrorMessage(playerid, "You don't have enought Deagle ammo (14) to load your ammo cartridge.");
			case SR_AMMO: if (Inventory_Count(playerid, "7.62x39mm") < GetWeaponClipSize(weaponid)) return SendErrorMessage(playerid, "You don't have enought Sniper ammo (10) to load your ammo cartridge.");
			case SG_AMMO: if (Inventory_Count(playerid, "12-gauge") < GetWeaponClipSize(weaponid)) return SendErrorMessage(playerid, "You don't have enought Shotgun ammo (30) to load your ammo cartridge.");
		
