		    strcat(string, "** Hitman: /contracts, /takehit, /profile, /passport, /plantbomb, /pickupbomb, /detonate, /hmole, /hfind");
		}
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{FFFFFF}Current commands on "SVRCLR"Valley Rp City Roleplay", string, "Close","");
	return 1;
}

