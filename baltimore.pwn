	if(dialogid == VEHICLE_TOYS_EDIT)
	{
		if(response)
		{
			new action = GetPVarInt(playerid, "CarToyAction"), x;
			DeletePVar(playerid, "CarToyAction");

			if(!IsVehicleOwner(playerid, carid))  
				return SCM(playerid, COLOR_ERROR, "You are not inside of any vehicle!");
			
			for(new i=0;i<MAX_VEHICLE_TOYS;i++)
			{
				if(CarToysInfo[carid][i][CarToys_ObjID] != 0)
				{
					if(x++ == listitem)
					{
						if(action == 0)
						{
							RespawnCarObjectForMoving(CarToysInfo[carid][i][CarToys_ObjID]);
						}
						else if(action == 1)
						{
							RespawnCarObjectForMoving(CarToysInfo[carid][i][CarToys_ObjID]);
						}
						else if(action == 2)
						{
							DestroyCarToy(CarToysInfo[carid][i][CarToys_ObjID]);
						}
					}
				}
			}
		}
		else ShowVehicleToysMenu(playerid);
	}
	if(dialogid == VEHICLE_TOYS_MENU)
	{
		if(response)
