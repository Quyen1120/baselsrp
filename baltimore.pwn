		// SendMessage(playerid, MESSAGE_INFO, "NOTE: 9mm is the ammo used for pistols and some smg weapons. ");
			return 1;
		}
		if(CompareStrings(params, "bat")) {
			
			if(Inventory_Count(playerid, STEELC) >= 30 && Inventory_Count(playerid, BLUEBATC) >= 1) {

				Inventory_Remove(playerid, "Steel", 30);
