			    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET seeds = %i WHERE uid = %i", pData[offeredby][pSeeds], pData[offeredby][pID]);
			    mysql_tquery(connectionID, queryBuffer);

