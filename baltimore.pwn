stock Inventory_Clear(playerid)
{
	static
	    string[64];

	for (new i = 0; i < MAX_INVENTORY; i ++)
	{
	    if (InventoryData[playerid][i][invExists])
	    {
	        InventoryData[playerid][i][invExists] = 0;
	        InventoryData[playerid][i][invModel] = 0;
	        InventoryData[playerid][i][invQuantity] = 0;

			if(ShowingInventory[playerid]) {
				PlayerTextDrawSetPreviewModel(playerid, g_InventoryPreviewModel[playerid][i], 19300);
				PlayerTextDrawSetString(playerid, gInventoryItemName[playerid][i], " ");
				PlayerTextDrawSetString(playerid, gInventoryQuantity[playerid][i], " ");
				PlayerTextDrawUseBox(playerid, g_InventoryGreenBox[playerid][i], false);
				PlayerTextDrawHide(playerid, g_InventoryGreenBox[playerid][i]);
				PlayerTextDrawHide(playerid, g_InventoryPreviewModel[playerid][i]);
				PlayerTextDrawShow(playerid, g_InventoryPreviewModel[playerid][i]);
			}	
		}
	}
	format(string, sizeof(string), "DELETE FROM `newinventory` WHERE `ownerID` = '%d'", pData[playerid][pID]);
	return mysql_tquery(connectionID, string);
}

CMD:cellphone(playerid, params[])
{
    ShowHomePhone(playerid);
    
    SelectTextDraw(playerid, 0xFFFFFFFF);
    return 1;
}

CMD:hidecellphone(playerid, params[])
{
    HideHomePhone(playerid);
    
    CancelSelectTextDraw(playerid);
    return 1;
}

CMD:hmenu(playerid)
{
    for(new i = 0; i < 19; i++)
    {
        TextDrawShowForPlayer(playerid, HMenuTD[i]);
    }

    SelectTextDraw(playerid, 0xFFFFFFFF);

    return 1;
}

CMD:closemenu(playerid)
{
    for(new i = 0; i < 19; i++)
    {
        TextDrawHideForPlayer(playerid, HMenuTD[i]);
    }

    CancelSelectTextDraw(playerid);

    return 1;
}

CMD:vehpad(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, -1, "You must be inside a vehicle.");

    for(new i; i < 45; i++)
    {
        TextDrawShowForPlayer(playerid, IpadCapital[i]);
    }

    SelectTextDraw(playerid, 0xFFFFFFFF);

    PlayerVehicleIpad[playerid] = GetPlayerVehicleID(playerid);

    return 1;
}

CMD:closevehpad(playerid, params[])
{
    for(new i; i < 45; i++)
    {
        TextDrawHideForPlayer(playerid, IpadCapital[i]);
    }

    CancelSelectTextDraw(playerid);

    SendClientMessage(playerid, -1, "Vehicle iPad closed.");

    return 1;
}

CMD:spraymoney(playerid, params[])
{
    if(IsSprayingMoney[playerid])
    {
        IsSprayingMoney[playerid] = false;

        KillTimer(MoneySprayTimer[playerid]);

        RemovePlayerAttachedObject(playerid, 5);

        ClearAnimations(playerid);

        SendClientMessage(playerid, -1, "You stopped spraying money.");

        return 1;
    }

    IsSprayingMoney[playerid] = true;

    ApplyAnimation(playerid, "STRIP", "PLY_CASH", 4.1, 1, 0, 0, 1, 0, 1);

    SetPlayerAttachedObject(playerid,
5,
1212,
5,
0.120000,
0.020000,
0.000000,
0.000000,
90.000000,
0.000000,
1.000000,
1.000000,
1.000000);

    MoneySprayTimer[playerid] = SetTimerEx("SprayMoneyLoop", 2000, true, "i", playerid);

    SendClientMessage(playerid, -1, "You started spraying money.");

    return 1;
}

